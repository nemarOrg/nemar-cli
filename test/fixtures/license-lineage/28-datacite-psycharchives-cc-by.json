{"data":{"id":"10.23668/psycharchives.22830","type":"dois","attributes":{"doi":"10.23668/psycharchives.22830","prefix":"10.23668","suffix":"psycharchives.22830","identifiers":[{"identifier":"https://hdl.handle.net/20.500.12034/18152","identifierType":"uri"}],"alternateIdentifiers":[{"alternateIdentifierType":"uri","alternateIdentifier":"https://hdl.handle.net/20.500.12034/18152"}],"creators":[{"name":"Praček, Andreja","affiliation":[],"nameIdentifiers":[]},{"name":"Vehovar, Vasja","affiliation":[],"nameIdentifiers":[]},{"name":"Čehovin, Gregor","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Dataset for: Travel Habits, Use of Information and Communication Technologies (ICT) and Risk Behaviours, Valicon (trips file)"},{"title":"Podatkovna baza za raziskavo Potovalne navade, uporaba informacijsko-komunikacijskih tehnologij (IKT) in tvegana vedenja, Valicon (baza potovanj)","titleType":"AlternativeTitle"}],"publisher":"Leibniz Institute for Psychology (ZPID)","container":{},"publicationYear":2026,"subjects":[{"subject":"web panel"},{"subject":"web surveys"},{"subject":"survey estimate quality"},{"subject":"tourism trips"},{"subject":"information and communication technologies"},{"subject":"internet use"},{"subject":"tobacco"},{"subject":"alcohol"},{"subject":"cannabis"},{"subject":"video games"},{"subject":"150","subjectScheme":"ddc"}],"contributors":[{"name":"PsychArchives","contributorType":"DataManager","nameIdentifiers":[{"schemeUri":"https://re3data.org/","nameIdentifier":"https://www.re3data.org/repository/r3d100013107","nameIdentifierScheme":"re3data"}],"affiliation":[]},{"name":"Leibniz Institute for Psychology (ZPID)","contributorType":"HostingInstitution","nameIdentifiers":[{"schemeUri":"https://ror.org","nameIdentifier":"https://ror.org/0165gz615","nameIdentifierScheme":"ROR"}],"affiliation":[]}],"dates":[{"date":"2026-11-26","dateType":"Accepted"},{"date":"2026-11-26","dateType":"Available"},{"date":"2026-11-18","dateType":"Created"},{"date":"2026-11-26","dateType":"Issued"}],"language":"en","types":{"ris":"DATA","bibtex":"misc","citeproc":"dataset","schemaOrg":"Dataset","resourceType":"researchData","resourceTypeGeneral":"Dataset"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":null,"rightsList":[{"rights":"CC-BY 4.0"},{"rights":"openAccess"},{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"The study is the second wave (Wave 2), conducted in the Valicon web panel JazVem. The same questionnaire was carried out in the same period in the 1KA web panel, a probability web panel established by the Centre for Social Informatics within project V5-2157. The aim of the project is to examine the potential of a general-population probability web panel for the needs of official statistics, to shed light on survey costs and the quality of statistical estimates, and to develop comparative evaluation criteria. The implementation in the Valicon panel allows comparison with estimates from a commercial web panel. The questionnaire was purposely composed of replications of existing survey instruments of the Statistical Office of the Republic of Slovenia and the National Institute of Public Health. It covers three thematic modules: travel by the population in the first quarter of 2023, use of the internet and information and communication technologies, and health-related habits (use of tobacco and related products, marijuana, alcohol and cannabis for medical purposes, and playing video games). This allows direct comparison of estimates obtained through the web panel with estimates from the original implementations of the same surveys.","descriptionType":"Abstract"},{"description":"1_Wave2_Valicon_persons: README.txt; Wave2_Valicon_data_preparation_report.pdf; Wave2_Valicon_persons_codebook.csv; Wave2_Valicon_persons_data.csv; Wave2_Valicon_study_description.pdf. 2_Wave2_Valicon_trips: README.txt; Wave2_Valicon_trips_codebook.csv; Wave2_Valicon_trips_data.csv. 3_Wave2_Valicon_questionnaire: README.txt; Wave2_Valicon_questionnaire.pdf.","descriptionType":"TableOfContents"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://www.psycharchives.org/jspui/handle/20.500.12034/18152","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-11-26T17:00:08.000Z","registered":"2026-11-26T17:00:19.000Z","published":"2026","updated":"2026-11-26T17:10:07.000Z"},"relationships":{"client":{"data":{"id":"gesis.psycharc","type":"clients"}},"provider":{"data":{"id":"vpwd","type":"providers"}},"media":{"data":{"id":"10.23668/psycharchives.22830","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}