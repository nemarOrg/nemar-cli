nses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"The open access dataset we have provided aim to precisely measure cerebral oxygen levels and EEG dynamics, with a particular focus on populations in extreme environments such as hypoxia. This resource holds significant promise, especially for individuals facing oxygen deficiency challenges. The comprehensive nature of our dataset offers a robust foundation for refining and optimizing technologies dedicated to monitoring neurophysiological responses in real-world, high-altitude scenarios. We anticipate that our contributions will foster advancements in medical instrumentation and computational methodologies, ultimately enhancing our ability to safeguard the well-being of individuals exposed to extreme environmental conditions.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://springernature.figshare.com/collections/EEG_and_fNIRS_Datasets_Based_on_Stroop_Task_during_Two_Weeks_of_High-Altitude_Exposure_in_New_Immigrants/6979581/1","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2024-04-08T06:14:17.000Z","registered":"2024-04-08T06:14:21.000Z","published":"2024","updated":"2024-04-08T06:14:22.000Z"},"relationships":{"client":{"data":{"id":"figshare.ars","type":"clients"}},"provider":{"data":{"id":"otjm","type":"providers"}},"media":{"data":{"id":"10.6084/m9.figshare.c.6979581.v1","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}