oad_disabled": false, "description": "The open access dataset we have provided aim to precisely measure cerebral oxygen levels and EEG dynamics, with a particular focus on populations in extreme environments such as hypoxia. This resource holds significant promise, especially for individuals facing oxygen deficiency challenges. The comprehensive nature of our dataset offers a robust foundation for refining and optimizing technologies dedicated to monitoring neurophysiological responses in real-world, high-altitude scenarios. We anticipate that our contributions will foster advancements in medical instrumentation and computational methodologies, ultimately enhancing our ability to safeguard the well-being of individuals exposed to extreme environmental conditions.", "funding": null, "funding_list": [], "version": 1, "status": "public", "size": 1610438911, "created_date": "2024-04-05T16:06:18Z", "modified_date": "2024-04-05T16:06:19Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 2, "name": "CC0", "url": "https://creativecommons.org/publicdomain/zero/1.0/"}, "tags": ["fNIRS", "EEG", "Stroop", "high altitude"], "keywords": ["fNIRS", "EEG", "Stroop", "high altitude"], "categories": [{"id": 189, "title": "Optical Physics not elsewhere classified", "parent_id": 6, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 532, "title": "Biomechanical Engineering", "parent_id": 5, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 536, "title": "Biomedical Engineering not elsewhere classified", "parent_id": 5, "path": "", "source_id": "", "taxonomy_id": 10}], "references": [], "has_linked_file": false, "citation": "Li, Ting; Ji, Xiang; Bao, Botao; Li, Lin Z.; Pu, Jiangbo; Lin, Yu; et al. (2024). EEG and fNIRS Datasets Based on Stroop Task during Two Weeks of High-Altitude Exposure in New Immigrants. figshare. Dataset. https://doi.org/10.6084/m9.figshare.24803499.v1", "rela