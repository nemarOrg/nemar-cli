{"schema_version":"0.4.1","doc_type":"dataset","dataset_id":"on003751","name":"Dataset on Emotion with Naturalistic Stimuli (DENS)","description":"The Dataset on Emotion with Naturalistic Stimuli (DENS) contains EEG, ECG and EMG recordings from 40 participants who were emotionally stimulated with naturalistic multimedia videos. The videos provide context for the situated conceptualization of emotions. Participants gave self-assessment ratings of valence, arousal, dominance, liking, familiarity, relevance and emotion category. The dataset also includes stimuli, code for data collection, validation and pre-processing.","source":"nemar","recording_modality":["BEH","EEG"],"bids_version":null,"license":"CC0","authors":[{"name":"Sudhakar Mishra","name_type":"Personal"},{"name":"Md. Asif","name_type":"Personal"},{"name":"Uma Shanker Tiwary","name_type":"Personal"},{"name":"Narayanan Srinivasan","name_type":"Personal"}],"anonymous":false,"keywords":[{"term":"EEG"},{"term":"Electrocardiography","subject_scheme":"MeSH","value_uri":"http://id.nlm.nih.gov/mesh/D004562"},{"term":"Electromyography","subject_scheme":"MeSH","value_uri":"http://id.nlm.nih.gov/mesh/D004576"},{"term":"Emotions","subject_scheme":"MeSH","value_uri":"http://id.nlm.nih.gov/mesh/D004644"},{"term":"naturalistic stimuli"},{"term":"affective neuroscience"}],"related_identifiers":[{"identifier":"https://github.com/nemarDatasets/on003751","identifier_type":"URL","relation_type":"IsDescribedBy"},{"identifier":"10.18112/openneuro.ds003751.v1.0.2","identifier_type":"DOI","relation_type":"IsDerivedFrom"},{"identifier":"https://nemar.org/dataset/on003751","identifier_type":"URL","relation_type":"IsDescribedBy"}],"data_papers":[],"contributors":[],"dates":[],"rights":[{"rights":"CC0","rights_uri":null,"rights_identifier":"CC0","rights_identifier_scheme":"SPDX"}],"language":null,"funding":[],"tasks":["Emotion","emotion"],"datatypes":["beh","eeg"],"sessions":[],"sessions_count":null,"demographics":{"subjects_count":40,