{"schema_version":"0.4.1","doc_type":"dataset","dataset_id":"nm000276","name":"SWEC iEEG Dataset","description":"Long-term pre-surgical intracranial EEG (iEEG) recordings from 40 patients with pharmacoresistant epilepsy, collected at the Sleep-Wake-Epilepsy-Center of Inselspital, University of Bern, in collaboration with ETH Zurich. The dataset contains 5376 hours of continuous recording with 381 annotated electrographic seizures. Data are fully anonymized, with generic channel names (recorded as generic SEEG type although electrodes are mixed strip, grid, and depth) and no electrode coordinates. It is converted to BIDS from the public SWEC-ETHZ HDF5 release and re-hosts the 40-subject / 378-file public subset of that release (http://ieeg-swez.ethz.ch/).","source":"nemar","recording_modality":["IEEG"],"bids_version":null,"license":"CDLA-Permissive-2.0","authors":[{"name":"Francesco Carzaniga","name_type":"Personal"},{"name":"Michael Hersche","name_type":"Personal"},{"name":"Abu Sebastian","name_type":"Personal"},{"name":"Kaspar Schindler","name_type":"Personal"},{"name":"Abbas Rahimi","name_type":"Personal"}],"anonymous":false,"keywords":[{"term":"intracranial EEG"},{"term":"iEEG"},{"term":"Epilepsy","subject_scheme":"MeSH","value_uri":"http://id.nlm.nih.gov/mesh/D004827"},{"term":"Seizures","subject_scheme":"MeSH","value_uri":"http://id.nlm.nih.gov/mesh/D012640"},{"term":"long-term monitoring"},{"term":"seizure detection"}],"related_identifiers":[{"identifier":"10.48550/arXiv.2506.20354","identifier_type":"DOI","relation_type":"References"},{"identifier":"https://github.com/nemarDatasets/nm000276","identifier_type":"URL","relation_type":"IsDescribedBy"},{"identifier":"https://nemar.org/dataset/nm000276","identifier_type":"URL","relation_type":"IsDescribedBy"}],"data_papers":[{"doi":"10.48550/arxiv.2506.20354","title":"A foundation model with multi-variate parallel attention to generate neuronal activity","year":2025,"venue":"arXiv (Cornell University)","judge_model