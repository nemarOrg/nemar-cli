{"schema_version":"0.4.1","doc_type":"dataset","dataset_id":"nm000149","name":"BNCI 2019-001 Motor Imagery dataset for Spinal Cord Injury patients","description":"EEG recordings from 10 persons with cervical spinal cord injury performing attempted arm and hand movements: hand open, palmar grasp, lateral grasp, pronation and supination. Sixty-one EEG channels and 3 EOG channels were recorded at 256 Hz across 9 runs, giving 360 trials per participant. The data show that movement-related cortical potentials in low-frequency EEG can be decoded offline in five classes. They also support an online proof-of-concept for self-paced movement detection, relevant to neuroprosthetic control.","source":"nemar","recording_modality":["EEG"],"bids_version":null,"license":"CC-BY-4.0","authors":[{"name":"Patrick Ofner","name_type":"Personal","orcid":"0000-0001-7169-4300"},{"name":"Andreas Schwarz","name_type":"Personal","orcid":"0000-0002-3883-4989"},{"name":"Joana Pereira","name_type":"Personal","orcid":"0000-0002-2032-8981"},{"name":"Daniela Wyss","name_type":"Personal"},{"name":"Renate Wildburger","name_type":"Personal"},{"name":"Gernot R. Müller-Putz","name_type":"Personal","orcid":"0000-0002-0087-3720"}],"anonymous":false,"keywords":[{"term":"EEG"},{"term":"Spinal Cord Injuries","subject_scheme":"MeSH","value_uri":"http://id.nlm.nih.gov/mesh/D013119"},{"term":"motor imagery"},{"term":"attempted movement"},{"term":"movement-related cortical potentials"},{"term":"Brain-Computer Interfaces","subject_scheme":"MeSH","value_uri":"http://id.nlm.nih.gov/mesh/D062207"},{"term":"neuroprosthetics"}],"related_identifiers":[{"identifier":"10.1038/s41598-019-43594-9","identifier_type":"DOI","relation_type":"IsDerivedFrom"},{"identifier":"10.5281/zenodo.2222268","identifier_type":"DOI","relation_type":"IsDerivedFrom"},{"identifier":"https://github.com/nemarDatasets/nm000149","identifier_type":"URL","relation_type":"IsDescribedBy"},{"identifier":"https://nemar.org/dataset/nm000149","identifier_t