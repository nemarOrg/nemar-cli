{"schema_version":"0.4.1","doc_type":"dataset","dataset_id":"nm000118","name":"Nakanishi2015 – SSVEP Nakanishi 2015 dataset","description":"A 12-class steady-state visual evoked potential (SSVEP) EEG dataset using joint frequency-phase modulation, recorded from healthy participants during a simulated online brain-computer interface experiment. Eight occipital and parieto-occipital channels were recorded at 256 Hz while subjects gazed at flickering targets on a 4x3 virtual keypad. The data were originally used to compare canonical correlation analysis (CCA) based SSVEP detection methods.","source":"nemar","recording_modality":["EEG"],"bids_version":null,"license":"Unknown","authors":[{"name":"Masaki Nakanishi","name_type":"Personal"},{"name":"Yijun Wang","name_type":"Personal"},{"name":"Yu-Te Wang","name_type":"Personal"},{"name":"Tzyy-Ping Jung","name_type":"Personal"}],"anonymous":false,"keywords":[{"term":"EEG"},{"term":"SSVEP"},{"term":"steady-state visual evoked potentials"},{"term":"brain-computer interface"},{"term":"canonical correlation analysis"},{"term":"frequency-phase coding"},{"term":"Brain-Computer Interfaces","subject_scheme":"MeSH","value_uri":"http://id.nlm.nih.gov/mesh/D062207"}],"related_identifiers":[{"identifier":"10.1371/journal.pone.0140703","identifier_type":"DOI","relation_type":"IsDerivedFrom"},{"identifier":"https://github.com/nemarDatasets/nm000118","identifier_type":"URL","relation_type":"IsDescribedBy"},{"identifier":"https://nemar.org/dataset/nm000118","identifier_type":"URL","relation_type":"IsDescribedBy"}],"data_papers":[{"doi":"10.1371/journal.pone.0140703","title":"A Comparison Study of Canonical Correlation Analysis Based Methods for Detecting Steady-State Visual Evoked Potentials","year":2015,"venue":"PLoS ONE","judge_model":"claude-sonnet-5-5"}],"contributors":[],"dates":[],"rights":[{"rights":"Unknown","rights_uri":null,"rights_identifier":"Unknown","rights_identifier_scheme":"SPDX"}],"language":null,"funding":[{"funder_name":