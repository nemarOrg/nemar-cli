{"schema_version":"0.4.1","doc_type":"dataset","dataset_id":"on003505","name":"VEPCON: Source imaging of high-density visual evoked potentials with multi-scale brain parcellations and connectomes","description":"VEPCON is a multimodal BIDS dataset with high-density EEG, structural MRI and diffusion-weighted imaging from 20 participants. Visual evoked potentials were recorded during face versus scrambled-face discrimination and coherent versus incoherent motion discrimination. Derivatives include preprocessed single-trial EEG, FreeSurfer outputs, multi-scale brain parcellations (83 to 1015 regions), structural connectomes, and EEG source-imaging inverse solutions, supporting multimodal methods development and structure-function studies.","source":"nemar","recording_modality":["ANAT","DWI","EEG"],"bids_version":null,"license":"CC0","authors":[{"name":"David Pascucci","name_type":"Personal","orcid":"0000-0002-1139-2586"},{"name":"Sebastien Tourbier","name_type":"Personal"},{"name":"Joan Rue-Queralt","name_type":"Personal"},{"name":"Margherita Carboni","name_type":"Personal"},{"name":"Patric Hagmann","name_type":"Personal"},{"name":"Gijs Plomp","name_type":"Personal","orcid":"0000-0002-9883-3371"}],"anonymous":false,"keywords":[{"term":"EEG"},{"term":"Evoked Potentials, Visual"},{"term":"source imaging"},{"term":"diffusion weighted imaging"},{"term":"structural connectome"},{"term":"brain parcellation"},{"term":"Magnetic Resonance Imaging"}],"related_identifiers":[{"identifier":"10.1038/s41597-021-01116-1","identifier_type":"DOI","relation_type":"IsDescribedBy"},{"identifier":"https://github.com/nemarDatasets/on003505","identifier_type":"URL","relation_type":"IsDescribedBy"},{"identifier":"10.18112/openneuro.ds003505.v1.1.1","identifier_type":"DOI","relation_type":"IsDerivedFrom"},{"identifier":"https://nemar.org/dataset/on003505","identifier_type":"URL","relation_type":"IsDescribedBy"}],"data_papers":[{"doi":"10.1038/s41597-021-01116-1","title":"Source imaging of high-