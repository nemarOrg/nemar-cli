{"schema_version":"0.4.1","doc_type":"dataset","dataset_id":"nm000210","name":"BCIAUT-P300 dataset for autism from Simoes et al 2020","description":"EEG dataset from 15 adolescents and adults with autism spectrum disorder who took part in a P300-based brain-computer interface joint-attention training in a virtual environment. Each participant completed 7 sessions in which 8 flashing objects served as targets or non-targets, with EEG recorded from 8 channels at 250 Hz. The data are epoched and preprocessed, and are provided as a benchmark for P300 classification within-subject, cross-session and cross-subject.","source":"nemar","recording_modality":["EEG"],"bids_version":null,"license":"CC-BY-4.0","authors":[{"name":"Marco Simoes","name_type":"Personal"},{"name":"Davide Borra","name_type":"Personal"},{"name":"Eduardo Santamaria-Vazquez","name_type":"Personal"},{"name":"Mayra Bittencourt-Villalpando","name_type":"Personal"},{"name":"Dominik Krzeminski","name_type":"Personal"},{"name":"Aleksandar Miladinovic","name_type":"Personal"},{"name":"Carlos Amaral","name_type":"Personal"},{"name":"Bruno Direito","name_type":"Personal"},{"name":"Miguel Castelo-Branco","name_type":"Personal"}],"anonymous":false,"keywords":[{"term":"EEG"},{"term":"P300"},{"term":"event-related potentials"},{"term":"Brain-Computer Interfaces","subject_scheme":"MeSH","scheme_uri":"https://id.nlm.nih.gov/mesh/","value_uri":"http://id.nlm.nih.gov/mesh/D062207"},{"term":"Autism Spectrum Disorder","subject_scheme":"MeSH","value_uri":"http://id.nlm.nih.gov/mesh/D000067877"},{"term":"joint attention training"}],"related_identifiers":[{"identifier":"10.3389/fnins.2020.568104","identifier_type":"DOI","relation_type":"IsDerivedFrom"},{"identifier":"https://github.com/nemarDatasets/nm000210","identifier_type":"URL","relation_type":"IsDescribedBy"},{"identifier":"10.21105/joss.01896","identifier_type":"DOI","relation_type":"References"},{"identifier":"10.1038/s41597-019-0104-8","identifier_type":"DOI","relatio