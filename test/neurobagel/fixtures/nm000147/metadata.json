{"schema_version":"0.4.1","doc_type":"dataset","dataset_id":"nm000147","name":"The Brain, Body, and Behaviour Dataset (1.0.0) - Experiment 4","description":"Experiment 4 of the Brain, Body, and Behavior Dataset (BBBD) contains multimodal recordings from 43 participants who watched short educational videos while EEG, EOG, ECG, respiration, pupil size, gaze, and head position were recorded. Session 1 was an attentive condition with factual multiple-choice questions after each video. Session 2 was a distracted condition in which participants silently counted backwards in steps of 7. Questionnaires, including the ASRS adult ADHD symptom checklist and stimulus-related knowledge questions, are provided.","source":"nemar","recording_modality":["BEH","EEG"],"bids_version":null,"license":"CC BY 4.0","authors":[{"name":"Jens Madsen","name_type":"Personal","orcid":"0000-0001-8163-001X"},{"name":"Nikhil Kuppa","name_type":"Personal"},{"name":"Lucas Parra","name_type":"Personal"}],"anonymous":false,"keywords":[{"term":"EEG"},{"term":"Electrocardiography","subject_scheme":"MeSH","value_uri":"http://id.nlm.nih.gov/mesh/D004562"},{"term":"Eye Movements","subject_scheme":"MeSH","value_uri":"http://id.nlm.nih.gov/mesh/D005133"},{"term":"Attention","subject_scheme":"MeSH","value_uri":"http://id.nlm.nih.gov/mesh/D001288"},{"term":"educational videos"},{"term":"multimodal physiology"},{"term":"EOG"},{"term":"respiration"},{"term":"pupillometry"},{"term":"ADHD"}],"related_identifiers":[{"identifier":"10.1101/2025.04.29.651259","identifier_type":"DOI","relation_type":"IsDescribedBy"},{"identifier":"https://github.com/nemarDatasets/nm000147","identifier_type":"URL","relation_type":"IsDescribedBy"},{"identifier":"10.1038/s41597-026-07215-1","identifier_type":"DOI","relation_type":"IsDerivedFrom"},{"identifier":"https://nemar.org/dataset/nm000147","identifier_type":"URL","relation_type":"IsDescribedBy"}],"data_papers":[{"doi":"10.1038/s41597-026-07215-1","title":"The Brain, Body, and Behavio