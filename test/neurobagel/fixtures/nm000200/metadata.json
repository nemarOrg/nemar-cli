{"schema_version":"0.4.1","doc_type":"dataset","dataset_id":"nm000200","name":"BigP3BCI Study I — 9x8 checkerboard/performance-based (13 healthy subjects)","description":"This dataset contains EEG recordings from 13 healthy participants in Study I of the bigP3BCI collection. Participants used a P300-based brain-computer interface speller with a 9x8 character grid and a checkerboard, performance-based stimulus paradigm. Data were recorded from 16 EEG channels at 256 Hz and annotated with Target and NonTarget events. The dataset is a BIDS-formatted derivative of the PhysioNet bigP3BCI release.","source":"nemar","recording_modality":["EEG"],"bids_version":null,"license":"CC-BY-4.0","authors":[{"name":"Boyla Mainsah","name_type":"Personal"},{"name":"Chance Fleeting","name_type":"Personal","orcid":"0000-0002-6271-4952","affiliations":[{"name":"Duke University","identifier":null,"scheme":null}]},{"name":"Thomas Balmat","name_type":"Personal"},{"name":"Eric Sellers","name_type":"Personal"},{"name":"Leslie Collins","name_type":"Personal"}],"anonymous":false,"keywords":[{"term":"EEG"},{"term":"P300"},{"term":"brain-computer interface"},{"term":"speller"},{"term":"event-related potentials"},{"term":"visual perception"}],"related_identifiers":[{"identifier":"10.13026/0byy-ry86","identifier_type":"DOI","relation_type":"IsDerivedFrom"},{"identifier":"https://github.com/nemarDatasets/nm000200","identifier_type":"URL","relation_type":"IsDescribedBy"},{"identifier":"10.21105/joss.01896","identifier_type":"DOI","relation_type":"References"},{"identifier":"10.1038/s41597-019-0104-8","identifier_type":"DOI","relation_type":"References"},{"identifier":"https://nemar.org/dataset/nm000200","identifier_type":"URL","relation_type":"IsDescribedBy"}],"data_papers":[],"contributors":[],"dates":[],"rights":[{"rights":"CC-BY-4.0","rights_uri":null,"rights_identifier":"CC-BY-4.0","rights_identifier_scheme":"SPDX"}],"language":null,"funding":[],"tasks":["p300"],"datatypes":["eeg"],"sessions":["0"