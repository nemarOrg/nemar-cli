{"schema_version":"0.4.1","doc_type":"dataset","dataset_id":"nm000158","name":"Liu, Lv et al. 2023 — EEG datasets of stroke patients (motor imagery)","description":"EEG motor imagery dataset recorded from 50 acute stroke patients (1-30 days post-stroke) using a wireless portable semi-dry saline EEG system. Patients imagined left- or right-hand grasping during video-guided trials (40 per subject). It is presented as the first open dataset addressing left- and right-handed motor imagery in acute stroke, supporting BCI algorithm development and rehabilitation applications. Raw and preprocessed data and patient clinical characteristics are provided.","source":"nemar","recording_modality":["EEG"],"bids_version":null,"license":"CC-BY-4.0","authors":[{"name":"Haijie Liu","name_type":"Personal"},{"name":"Penghu Wei","name_type":"Personal"},{"name":"Haochong Wang","name_type":"Personal"},{"name":"Xiaodong Lv","name_type":"Personal"},{"name":"Wei Duan","name_type":"Personal"},{"name":"Meijie Li","name_type":"Personal"},{"name":"Yan Zhao","name_type":"Personal"},{"name":"Qingmei Wang","name_type":"Personal"},{"name":"Xinyuan Chen","name_type":"Personal"},{"name":"Gaige Shi","name_type":"Personal"},{"name":"Bo Han","name_type":"Personal"},{"name":"Junwei Hao","name_type":"Personal"}],"anonymous":false,"keywords":[{"term":"EEG"},{"term":"motor imagery"},{"term":"Brain-Computer Interfaces","subject_scheme":"MeSH","scheme_uri":"https://id.nlm.nih.gov/mesh/","value_uri":"http://id.nlm.nih.gov/mesh/D062207"},{"term":"Stroke","subject_scheme":"MeSH","value_uri":"http://id.nlm.nih.gov/mesh/D020521"},{"term":"Rehabilitation","subject_scheme":"MeSH","value_uri":"http://id.nlm.nih.gov/mesh/D012046"},{"term":"hand-grip imagery"}],"related_identifiers":[{"identifier":"10.1038/s41597-023-02787-8","identifier_type":"DOI","relation_type":"IsDerivedFrom"},{"identifier":"10.6084/m9.figshare.21679035.v5","identifier_type":"DOI","relation_type":"IsDerivedFrom"},{"identifier":"https://github.com/n