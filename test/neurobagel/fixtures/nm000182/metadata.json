{"schema_version":"0.4.1","doc_type":"dataset","dataset_id":"nm000182","name":"Multicenter iEEG dataset for classification of graphoelements and artifactual signals (MAYO)","description":"A BIDS conversion of a multicenter intracranial EEG (iEEG) dataset of 3-second single-channel clips for classifying graphoelements (physiological and pathological activity) and artifactual signals. Clips were recorded from stereo-EEG contacts at 5000 Hz and concatenated into runs per subject and contact. Events preserve the original labels, segment IDs, anatomy, reviewer IDs, seizure onset zone flags, and electrode types.","source":"nemar","recording_modality":["IEEG"],"bids_version":null,"license":"CC0","authors":[{"name":"Petr Nejedly","name_type":"Personal","orcid":"0000-0002-5382-2134"},{"name":"Vaclav Kremen","name_type":"Personal","orcid":"0000-0001-9844-7617"},{"name":"Vladimir Sladky","name_type":"Personal"},{"name":"Jan Cimbalnik","name_type":"Personal"},{"name":"Petr Klimes","name_type":"Personal"},{"name":"Filip Plesinger","name_type":"Personal"},{"name":"Filip Mivalt","name_type":"Personal"},{"name":"Vojtech Travnicek","name_type":"Personal"},{"name":"Ivo Viscor","name_type":"Personal"},{"name":"Martin Pail","name_type":"Personal"},{"name":"Josef Halamek","name_type":"Personal","orcid":"0000-0001-8986-796X"},{"name":"Benjamin Brinkmann","name_type":"Personal"},{"name":"Milan Brazdil","name_type":"Personal"},{"name":"Pavel Jurak","name_type":"Personal"},{"name":"Gregory Worrell","name_type":"Personal"}],"anonymous":false,"keywords":[{"term":"intracranial EEG"},{"term":"iEEG"},{"term":"stereo-EEG"},{"term":"artifact classification"},{"term":"graphoelements"},{"term":"Epilepsy","subject_scheme":"MeSH","value_uri":"http://id.nlm.nih.gov/mesh/D004827"},{"term":"seizure onset zone"}],"related_identifiers":[{"identifier":"10.1038/s41597-020-0532-5","identifier_type":"DOI","relation_type":"IsDescribedBy"},{"identifier":"https://github.com/nemarDatasets/nm000182","identifier_typ