{"schema_version":"0.4.1","doc_type":"dataset","dataset_id":"nm000229","name":"Gwilliams et al. 2023 — Introducing MEG-MASC: a high-quality magneto-encephalography dataset for evaluating natural speech processing","description":"MEG-MASC is a curated set of raw magnetoencephalography recordings from 27 English speakers who listened to about two hours of naturalistic stories drawn from the Manually Annotated Sub-Corpus (MASC). Each participant completed two sessions with four fictional stories, interleaved with random word lists and comprehension questions. Word and phoneme onsets and offsets are time-stamped in the event files, and the data are organized in BIDS. The dataset serves as a benchmark for large-scale encoding and decoding analyses of temporally resolved brain responses to speech.","source":"nemar","recording_modality":["ANAT","MEG"],"bids_version":null,"license":"CC0","authors":[{"name":"Laura Gwilliams","name_type":"Personal","orcid":"0000-0002-9213-588X"},{"name":"Graham Flick","name_type":"Personal"},{"name":"Alec Marantz","name_type":"Personal"},{"name":"Liina Pylkkänen","name_type":"Personal"},{"name":"David Poeppel","name_type":"Personal","orcid":"0000-0003-0184-163X"},{"name":"Jean-Rémi King","name_type":"Personal"}],"anonymous":false,"keywords":[{"term":"MEG"},{"term":"Magnetoencephalography","subject_scheme":"MeSH","value_uri":"http://id.nlm.nih.gov/mesh/D015225"},{"term":"speech comprehension"},{"term":"naturalistic stories"},{"term":"phoneme decoding"},{"term":"language"}],"related_identifiers":[{"identifier":"10.1038/s41597-023-02752-5","identifier_type":"DOI","relation_type":"IsDerivedFrom"},{"identifier":"https://github.com/nemarDatasets/nm000229","identifier_type":"URL","relation_type":"IsDescribedBy"},{"identifier":"https://nemar.org/dataset/nm000229","identifier_type":"URL","relation_type":"IsDescribedBy"},{"identifier":"10.21105/joss.01896","identifier_type":"DOI","relation_type":"References"},{"identifier":"10.1038/sdata.2018.110","ide