{"schema_version":"0.4.1","doc_type":"dataset","dataset_id":"on003194","name":"Neuroepo multisession","description":"Resting-state EEG recorded from 25 patients with Parkinson's disease enrolled in a double-blind, randomized, placebo-controlled trial of Neuroepo, an erythropoietin formulation with low sialic acid content. Participants received Neuroepo (n=15) or placebo (n=10), and EEG was recorded before and six months after administration. Raw data are provided in EEG-BIDS format to support assessment of qualitative and quantitative EEG (source-level) biomarkers of neuroprotection.","source":"nemar","recording_modality":["EEG"],"bids_version":null,"license":"CC0","authors":[{"name":"Maria Luisa Bringas Vega","name_type":"Personal"},{"name":"Lilia Morales Chacon ","name_type":"Personal"},{"name":"Ivonne Pedroso Ibanez","name_type":"Personal"}],"anonymous":false,"keywords":[{"term":"EEG"},{"term":"Parkinson Disease","subject_scheme":"MeSH","value_uri":"http://id.nlm.nih.gov/mesh/D010300"},{"term":"Erythropoietin","subject_scheme":"MeSH","value_uri":"http://id.nlm.nih.gov/mesh/D004921"},{"term":"resting state"},{"term":"quantitative EEG"},{"term":"neuroprotection"},{"term":"randomized controlled trial"}],"related_identifiers":[{"identifier":"10.18112/openneuro.ds003194.v1.0.3","identifier_type":"DOI","relation_type":"IsDerivedFrom"},{"identifier":"https://github.com/nemarDatasets/on003194","identifier_type":"URL","relation_type":"IsDescribedBy"},{"identifier":"https://nemar.org/dataset/on003194","identifier_type":"URL","relation_type":"IsDescribedBy"}],"data_papers":[],"contributors":[],"dates":[],"rights":[{"rights":"CC0","rights_uri":null,"rights_identifier":"CC0","rights_identifier_scheme":"SPDX"}],"language":null,"funding":[{"funder_name":"National Natural Science Foundation of China","award_number":"61871105","award_title":null,"funder_identifier":null,"funder_identifier_type":null,"award_uri":null},{"funder_name":"National Natural Science Foundation of China","