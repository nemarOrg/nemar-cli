{"schema_version":"0.4.1","doc_type":"dataset","dataset_id":"nm000157","name":"BigP3BCI Study B — 6x6 checkerboard, multi-session (19 healthy subjects)","description":"This dataset is Study B of the bigP3BCI collection: EEG recordings from 19 participants using a P300-based speller with a 6x6 character checkerboard paradigm across 8 sessions per subject. Data were recorded from 16 EEG channels at 256 Hz with a g.USBamp amplifier, with Target and NonTarget events annotated using HED. This version is a MOABB-derived BIDS conversion of the PhysioNet bigP3BCI dataset, intended for brain-computer interface research and benchmarking.","source":"nemar","recording_modality":["EEG"],"bids_version":null,"license":"CC-BY-4.0","authors":[{"name":"Boyla Mainsah","name_type":"Personal"},{"name":"Chance Fleeting","name_type":"Personal","orcid":"0000-0002-6271-4952","affiliations":[{"name":"Duke University","identifier":null,"scheme":null}]},{"name":"Thomas Balmat","name_type":"Personal"},{"name":"Eric Sellers","name_type":"Personal"},{"name":"Leslie Collins","name_type":"Personal"}],"anonymous":false,"keywords":[{"term":"EEG"},{"term":"P300"},{"term":"Brain-Computer Interfaces","subject_scheme":"MeSH","scheme_uri":"https://id.nlm.nih.gov/mesh/","value_uri":"http://id.nlm.nih.gov/mesh/D062207"},{"term":"speller"},{"term":"event-related potentials"},{"term":"amyotrophic lateral sclerosis"}],"related_identifiers":[{"identifier":"10.13026/0byy-ry86","identifier_type":"DOI","relation_type":"IsDerivedFrom"},{"identifier":"https://github.com/nemarDatasets/nm000157","identifier_type":"URL","relation_type":"IsDescribedBy"},{"identifier":"10.21105/joss.01896","identifier_type":"DOI","relation_type":"References"},{"identifier":"10.1038/s41597-019-0104-8","identifier_type":"DOI","relation_type":"References"},{"identifier":"https://nemar.org/dataset/nm000157","identifier_type":"URL","relation_type":"IsDescribedBy"}],"data_papers":[{"doi":"10.13026/0byy-ry86","title":"bigP3BCI: An Open, Diverse