{"schema_version":"0.4.1","doc_type":"dataset","dataset_id":"on004166","name":"Effects of Forward and Backward Span Trainings on Working Memory: Evidence from a Randomized, Controlled Trial","description":"This dataset contains EEG/ERP recordings from a randomized controlled trial comparing forward span training, backward span training, and no-intervention control groups on working memory. Recordings were collected at pre-, mid-, and post-test while participants performed a distractor version of the change detection task, and behavioral data were collected from additional change detection and suppress tasks. The data support analyses of working memory maintenance and interference control, indexed by Kmax and contralateral delay activity (CDA).","source":"nemar","recording_modality":["EEG"],"bids_version":null,"license":"CC0","authors":[{"name":"Yang Li (data and curation)","name_type":"Personal"},{"name":"Wenjin Fu (data)","name_type":"Personal"},{"name":"Qiumei Zhang (data)","name_type":"Personal"},{"name":"Xiongying Chen (data)","name_type":"Personal"},{"name":"Xiaohong Li (data)","name_type":"Personal"},{"name":"Boqi Du (data)","name_type":"Personal"},{"name":"Xiaoxiang Deng (data)","name_type":"Personal"},{"name":"Feng Ji (curation)","name_type":"Personal"},{"name":"Qi Dong (curation)","name_type":"Personal"},{"name":"Susanne M. Jaeggi (curation)","name_type":"Personal"},{"name":"Chuansheng Chen (curation)","name_type":"Personal"},{"name":"Jun Li (data and curation)","name_type":"Personal"}],"anonymous":false,"keywords":[{"term":"EEG"},{"term":"event-related potentials"},{"term":"working memory"},{"term":"cognitive training"},{"term":"randomized controlled trial"},{"term":"contralateral delay activity"},{"term":"change detection task"}],"related_identifiers":[{"identifier":"https://github.com/nemarDatasets/on004166","identifier_type":"URL","relation_type":"IsDescribedBy"},{"identifier":"10.18112/openneuro.ds004166","identifier_type":"DOI","relation_type":"IsVers