# Copy to test/.env.test (gitignored) to run the live test tier.
#
# WITHOUT this file the live tier is BLOCKED, not silently redirected: the harness
# used to default TEST_API_URL to https://api.nemar.org, so a plain `bun test` in a
# fresh clone sent real requests to production -- and one suite got as far as
# minting a production device code and opening a browser on the sign-in page.
# test/live-target.ts now refuses that and points the run at a dead address instead.
#
# The pure tier (unit tests, no backend) needs none of this and is unaffected.

# ---------------------------------------------------------------------------
# Required for the live tier
# ---------------------------------------------------------------------------

# The backend under test. Never production. The dev worker deploys from `dev`:
TEST_API_URL=https://nemar-api-dev.sccn-org.workers.dev

# Seeded by scripts/seed-dev-db.sql: the `test-admin` and `test-user` tokens.
# These are DEV tokens. Never put a production key here -- AGENTS.md's rule, and
# the reason the file is gitignored.
TEST_ADMIN_API_KEY=
TEST_USER_API_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# The seeded `test-owner` token. Only the owner-only routes need it (ADR 0048);
# admin-owner-key-mint-flow.test.ts probe-skips its owner cases when unset.
TEST_OWNER_API_KEY=

# Rate-limit bypass for the dev worker, sent as X-Test-Bypass.
TEST_BYPASS_TOKEN=

# Password used by fixtures that still exercise the password-era paths.
TEST_PASSWORD=TestPassword123!

# Fixture dataset ids. Each suite has a default; set these to pin a specific one.
TEST_DATASET_ID=
TEST_SANDBOX_DATASET_ID=
TEST_WITHDRAW_DATASET_ID=
TEST_DATA_DATASET=

# Opt-in switches for suites that are off by default because they cost time or
# create state: a sandbox dataset, the passwordless key-rotation path, and the
# duplicate-detection routes once they are deployed.
TEST_CREATE_SANDBOX=
TEST_PASSWORDLESS_ROTATION=
TEST_DEDUP_DEPLOYED=

# Milliseconds a suite waits on its "are these routes deployed yet" probe.
TEST_PROBE_TIMEOUT_MS=

# ---------------------------------------------------------------------------
# The escape hatch
# ---------------------------------------------------------------------------

# Set to 1/true/yes ONLY to test deliberately against production. Anything else,
# including 0 and false, is not an opt-in. Leave it unset.
# TEST_ALLOW_PROD=
