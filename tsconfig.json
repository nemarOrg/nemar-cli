{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["bun-types"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/**/*",
    "shared/**/*",
    "scripts/neurobagel/**/*.ts",
    "scripts/ci/pr-review*.ts",
    "scripts/ci/publication-review*.ts",
    "test/pr-review-hostile.test.ts",
    "test/pr-review-evidence-scale.test.ts",
    "test/pr-review-change-summarize.unit.test.ts",
    "test/pr-review-original.unit.test.ts",
    "test/fixtures/pr-review-hostile/*.ts",
    "test/fixtures/pr-review-canary/*.ts",
    "test/pr-review-original-set-a.test.ts",
    "test/publication-review-calibration.test.ts",
    "test/publication-review-contract.test.ts",
    "test/publication-review-evidence.test.ts",
    "test/publication-review-presend.test.ts",
    "test/publication-review-prompt.test.ts",
    "test/publication-review-workflow.test.ts",
    "scripts/identifier-fleet-lib.ts",
    "scripts/identifier-fleet-scan.ts",
    "scripts/identifier-screen-ci-lib.ts",
    "scripts/identifier-screen-ci.ts",
    "test/neurobagel-*.ts",
    "test/identifier-fleet.test.ts",
    "test/identifier-scan.test.ts",
    "test/identifier-preflight-contract.test.ts",
    "test/upload-identifier-preflight.test.ts",
    "test/upload-identifier-preflight-cli.test.ts",
    "test/upload-preflight-recording.test.ts",
    "test/identifier-screen-ci.test.ts",
    "test/identifier-scrub.test.ts",
    "scripts/scrub/**/*.ts",
    "test/scrub/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
