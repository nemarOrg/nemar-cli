{
  "name": "nemar-cli",
  "version": "0.1.0",
  "description": "CLI for NEMAR (Neuroelectromagnetic Data Archive and Tools Resource) dataset management",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "nemar": "dist/index.js"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node --minify",
    "test": "bun test",
    "lint": "biome check src/",
    "lint:fix": "biome check --fix src/",
    "format": "biome format --write src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "nemar",
    "bids",
    "neuroimaging",
    "eeg",
    "emg",
    "datalad",
    "cli"
  ],
  "author": "NEMAR Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nemarDatasets/nemar-cli.git"
  },
  "bugs": {
    "url": "https://github.com/nemarDatasets/nemar-cli/issues"
  },
  "homepage": "https://github.com/nemarDatasets/nemar-cli#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.1",
    "inquirer": "^9.2.15",
    "zod": "^3.23.8",
    "conf": "^13.0.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/inquirer": "^9.0.7",
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.5.4"
  }
}
