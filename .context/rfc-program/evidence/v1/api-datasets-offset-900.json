{"datasets":[{"dataset_id":"on000117","id":"on000117","name":"Multisubject, multimodal face processing","description":"A multi-subject, multi-modal neuroimaging dataset on face processing, combining structural MRI, fMRI, MEG and EEG from 16 healthy volunteers. Each participant was scanned once with MRI and once with MEG while viewing famous, unfamiliar and scrambled faces. Faces were shown as initial presentations, immediate repeats or delayed repeats (a 3x3 design), and participants made a symmetry judgment on each stimulus with a button press. The dataset has been used for multimodal integration methods, connectivity modelling and decoding competitions.","status":"active","visibility":"public","anonymous":0,"github_repo":"nemarDatasets/on000117","concept_doi":"10.82901/nemar.on000117","doi":"10.82901/nemar.on000117","created_at":"2026-03-08 09:35:23","updated_at":"2026-11-09 02:41:13","owner_username":"nemarAdmin","source":"openneuro","source_id":"ds000117","modalities":"anat,fmap,func,meg","participants":17,"tasks":"facerecognition,noise","authors":"Wakeman, DG, Henson, RN, Apšvalka, D","license":"CC0","file_size":90138927506,"num_citations":85,"num_dataset_citations":0,"num_datapaper_citations":85,"n_channels":null,"electrode_system":null,"has_hed":0,"hed_version":null,"total_files":2079,"data_complete":1,"bytes_present":272025832429,"first_published_at":"2026-03-08 09:59:41","subject_count":17,"file_size_bytes":90138927506,"sessions_count":9,"age_min":23,"age_max":31,"bids_version":"1.8.0","zarr_status":"ready","zarr_store_count":103,"zarr_converted_at":"2026-11-09 03:55:01","zarr_source_commit":"75ee9598391a9d6f6b811a1c38f470f48eff2137","zarr_errors":0,"zarr_failure_count":0,"zarr_deterministic":0,"zarr_failed_at":null,"zarr_verify_status":null,"zarr_verified_at":null,"zarr_requeue_at":null,"total_recording_duration":48659,"recording_duration_min":60,"recording_duration_max":519,"recording_count":103,"recordings_unavailable":0,"channel_count_min":321,"channel_