{
  "name": "nemar-api",
  "version": "0.9.10-dev5",
  "private": true,
  "scripts": {
    "dev": "wrangler dev -c wrangler-sccn.toml --env dev",
    "deploy": "wrangler deploy -c wrangler-sccn.toml",
    "deploy:dev": "wrangler deploy -c wrangler-sccn.toml --env dev",
    "db:migrate": "wrangler d1 migrations apply nemar-db -c wrangler-sccn.toml",
    "db:migrate:local": "wrangler d1 migrations apply nemar-db -c wrangler-sccn.toml --local",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "zod": "^3.23.0",
    "@hono/zod-validator": "^0.4.0",
    "bcryptjs": "^2.4.3",
    "aws4fetch": "^1.0.20"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241112.0",
    "wrangler": "^4.85.0",
    "typescript": "^5.6.0",
    "@types/bcryptjs": "^2.4.6"
  }
}
