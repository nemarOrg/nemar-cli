{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.nemar.org/schemas/nemar-ieeg-geometry-index.v1.json",
  "title": "NEMAR iEEG geometry index, version 1",
  "description": "Index of the subject surfaces written as brain-mesh v1 files beside a dataset's Zarr copy (geometry/index.json). Mesh paths are relative to the directory holding this file and content-addressed (meshes/<sha256>.mesh.bin), so entries may share a file. A mesh is in the frame its electrodes file declares: when vertex_offset_mm is not null, that vector (FreeSurfer's c_ras, millimeters) was ADDED to the surface vertices, which are in tkr RAS, to bring them into the contacts' scanner RAS. A grade of plausible (depth contacts) means an approximate alignment; specific means contacts on the cortex agree within 2.0 mm. Subject surfaces are display data, so plausible is enough to be listed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "pipeline_version",
    "source_commit",
    "entries",
    "skipped"
  ],
  "properties": {
    "schema": {
      "const": "nemar-ieeg-geometry-index"
    },
    "version": {
      "const": 1
    },
    "pipeline_version": {
      "type": "string",
      "minLength": 1
    },
    "source_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skipped"
      }
    }
  },
  "$defs": {
    "hemisphere": {
      "enum": [
        "L",
        "R"
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "session",
        "electrodes",
        "frame",
        "contact_type",
        "frame_choice",
        "vertex_offset_mm",
        "hemispheres",
        "fit",
        "sources",
        "meshes",
        "fit_before_decimation",
        "decimation"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1,
          "description": "Label without the sub- prefix."
        },
        "session": {
          "type": [
            "string",
            "null"
          ],
          "description": "Label without the ses- prefix."
        },
        "electrodes": {
          "type": "string",
          "minLength": 1,
          "description": "Dataset-relative path of the electrodes.tsv the mesh was verified against."
        },
        "frame": {
          "type": [
            "string",
            "null"
          ],
          "description": "iEEGCoordinateSystem of that electrodes file's coordsystem.json."
        },
        "contact_type": {
          "enum": [
            "ecog",
            "seeg"
          ],
          "description": "The type of the contacts that were fitted: ecog when every fitted contact is ECoG, else seeg (all contacts with coordinates). The rule applied is fit_rule."
        },
        "fit_rule": {
          "enum": [
            "ecog-2.0mm",
            "depth"
          ],
          "description": "Optional. The rule the fit was judged by: ecog-2.0mm (median at most 2.0 mm, used when the file has at least 3 ECoG contacts, the same minimum the FreeSurfer track uses) or depth (the sEEG rule over all contacts with coordinates). Absent in indexes written before the field existed."
        },
        "frame_choice": {
          "enum": [
            "as_declared",
            "c_ras"
          ]
        },
        "hemispheres": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hemisphere"
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "fit": {
          "$ref": "#/$defs/fit",
          "description": "The contacts' fit to the written mesh: distances measured on the written mesh, grade and inside fractions from the original closed surface."
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "meshes": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/hemisphere"
          },
          "additionalProperties": {
            "$ref": "#/$defs/mesh"
          },
          "minProperties": 1,
          "maxProperties": 2
        },
        "vertex_offset_mm": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            }
          ],
          "description": "The vector added to the surface vertices (c_ras), or null when the surface is used as declared."
        },
        "fit_before_decimation": {
          "$ref": "#/$defs/fit"
        },
        "decimation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "applied",
            "median_shift_mm",
            "p99_deviation_mm"
          ],
          "properties": {
            "applied": {
              "type": "boolean"
            },
            "median_shift_mm": {
              "type": [
                "number",
                "null"
              ],
              "description": "Change in the contacts' median distance caused by decimation (limit 0.5)."
            },
            "p99_deviation_mm": {
              "type": [
                "number",
                "null"
              ],
              "description": "99th percentile distance of the written vertices from the original surface (limit 1.0)."
            }
          }
        }
      }
    },
    "fit": {
      "type": "object",
      "description": "Contact fit in the verifier's own fields.",
      "additionalProperties": false,
      "required": [
        "median_mm",
        "p90_mm",
        "max_mm",
        "n_used",
        "n_total",
        "rule",
        "grade",
        "passed",
        "inside_fraction",
        "near_or_inside_fraction",
        "inside_evaluated",
        "n_ambiguous",
        "n_left_out",
        "reason"
      ],
      "properties": {
        "median_mm": {
          "type": "number"
        },
        "p90_mm": {
          "type": "number"
        },
        "max_mm": {
          "type": "number"
        },
        "n_used": {
          "type": "integer",
          "minimum": 0
        },
        "n_total": {
          "type": "integer",
          "minimum": 0
        },
        "rule": {
          "type": "string"
        },
        "grade": {
          "enum": [
            "specific",
            "plausible"
          ],
          "description": "specific: ECoG contacts within 2.0 mm; plausible: the depth rule."
        },
        "passed": {
          "const": true
        },
        "inside_fraction": {
          "type": [
            "number",
            "null"
          ]
        },
        "near_or_inside_fraction": {
          "type": [
            "number",
            "null"
          ]
        },
        "inside_evaluated": {
          "type": "boolean"
        },
        "n_ambiguous": {
          "type": "integer",
          "minimum": 0
        },
        "n_left_out": {
          "type": "integer",
          "minimum": 0,
          "description": "Contacts on the side of an absent hemisphere, not evaluated."
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "mesh": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes",
        "vertices",
        "faces",
        "boundary_edges",
        "non_manifold_edges"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^meshes/[0-9a-f]{64}\\.mesh\\.bin$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 40,
          "maximum": 1500000
        },
        "vertices": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "faces": {
          "type": "integer",
          "minimum": 0
        },
        "boundary_edges": {
          "type": "integer",
          "minimum": 0
        },
        "non_manifold_edges": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "skipped": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "session",
        "electrodes",
        "reason"
      ],
      "properties": {
        "subject": {
          "type": "string"
        },
        "session": {
          "type": [
            "string",
            "null"
          ]
        },
        "electrodes": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
