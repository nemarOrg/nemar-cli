# Dependencies
node_modules/
bun.lockb

# Build output
dist/

# Environment
.env
.env.local
.env.*.local
test/.env.test

# IDE
.idea/
.vscode/
*.swp
*.swo

# macOS
.DS_Store

# Testing
coverage/
*.lcov
test/.test-configs/
test/fixtures/**/.git/
test/fixtures/**/.nemar/
test/fixtures/**/.gitattributes


# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
tmp/
temp/
*.tmp

# Build output / local envs
site/
.venv/
.wrangler/

# Root-level wrangler.jsonc is for the unrelated nemar-cli static-site
# worker and would shadow backend/wrangler.toml when wrangler is invoked
# without an explicit -c flag. Keep it out of the tracked tree so it
# can't accidentally affect a backend deploy.
wrangler.jsonc

.dev.vars*
!.dev.vars.example
!.env.example
.claude/*.local.md
