#!/usr/bin/env bash
#
# nb-rollback: deliberately go back to an earlier release, and stay there.
#
#   nb rollback --list        the releases that are still on disk, newest first
#   nb rollback [RELEASE]     make RELEASE live, reload it, and FREEZE the loader. The default is
#                             the release that was LOADED AND VERIFIED before the live one (or, if
#                             the live release was never loaded, the one that is loaded); it is not
#                             simply the previously published release, which may never have loaded.
#
# The freeze matters: without it the next scheduled `nb load` would stage the newest content from
# the artifact store again, undoing the rollback within minutes. While frozen, nb-load fetches
# nothing and changes nothing. `nb load --thaw` ends the freeze.
#
# A reload that fails here is NOT rolled back automatically: you chose this release on purpose.
# Exit codes as nb-reload (0 loaded; 5/6 failed; 8 refused; 75 busy).

set -euo pipefail
# shellcheck source=nb-common.sh
. "$(dirname "${BASH_SOURCE[0]}")/nb-common.sh"

case "${1:-}" in
  -h | --help)
    nb_usage "$0"
    exit 0
    ;;
esac
nb_init_dirs
case "${1:-}" in
  --list)
    cur="$(nb_current_release || true)"
    for name in $(find "$NB_RELEASES_DIR" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort -r); do
      n="?"
      [ ! -f "$NB_MANIFESTS_DIR/$name.json" ] || n="$(jq -r '.counts.datasets' "$NB_MANIFESTS_DIR/$name.json")"
      printf '%s  %s dataset(s)%s\n' "$name" "$n" "$([ "$name" = "$cur" ] && echo '  <- live')"
    done
    exit 0
    ;;
esac

cur="$(nb_current_release || true)"
if [ -n "${1:-}" ]; then
  target="$1"
  nb_release_name_ok "$target" || nb_die "$NB_EX_USAGE" "not a release name: $target (see: nb rollback --list)"
else
  applied=""
  [ ! -f "$NB_STATE_DIR/applied.json" ] || applied="$(jq -r '.release // ""' "$NB_STATE_DIR/applied.json" 2>/dev/null || true)"
  target="$(nb_decide_manual_rollback_target "$cur" "$applied" "$(cat "$NB_STATE_DIR/previous-loaded" 2>/dev/null || true)" \
    "$(cat "$NB_STATE_DIR/rollback-to" 2>/dev/null || true)" "$NB_RELEASES_DIR")"
fi
[ -n "$target" ] || nb_die "$NB_EX_PREFLIGHT" "no earlier release is on disk to go back to; name one (see: nb rollback --list)"
[ -d "$NB_RELEASES_DIR/$target" ] || nb_die "$NB_EX_PREFLIGHT" "release not found: $target (see: nb rollback --list)"
[ "$target" != "$cur" ] || nb_die "$NB_EX_PREFLIGHT" "release $target is already live"

nb_lock_or_exit "nb-rollback"
nb_log "rolling back: $cur -> $target"
nb_atomic_symlink "releases/$target" "$NB_CURRENT_LINK"
[ -z "$cur" ] || printf '%s\n' "$cur" | nb_write_atomic "$NB_STATE_DIR/rollback-to"
printf '%s\n' "$target" | nb_write_atomic "$NB_STATE_DIR/pending-reload"
printf '%s by %s: rolled back from %s to %s\n' "$(nb_ts)" "${SUDO_USER:-${USER:-unknown}}" "${cur:-none}" "$target" \
  | nb_write_atomic "$NB_STATE_DIR/freeze"
nb_log "loader frozen; end the freeze with: nb load --thaw"
rc=0
"$NB_CODE_DIR/bin/nb-reload" --no-rollback || rc=$?
exit "$rc"
