#!/usr/bin/env bash
#
# nb-hold / nb-unhold: incident mode. Takes the node out of the federation in seconds and keeps
# it out until a person puts it back.
#
#   nb hold [reason...]   write the hold flag, then kill the node API container and confirm it is
#                         down (it polls, and kills again, until the container is not running or
#                         10 seconds have passed, and fails loudly if it never stops). The federation
#                         API of Neurobagel marks a node whose API does not answer as failed and
#                         returns no records from it. The graph store, the loader state and the
#                         data stay as they are; the loader keeps staging releases but never
#                         reloads, and a reload already in progress kills the API again if it
#                         starts it: a hold wins.
#   nb unhold             remove the flag and bring the API back. If a staged release is waiting it
#                         is reloaded first (which restarts the API); otherwise the API is just
#                         started and verified.
#
# Deliberately takes no lock: during an incident the hold must not wait for a running load.
# Never touches any other project. Exit codes: 0 done; 9 the API would not stop; 8 refused.

set -euo pipefail
# shellcheck source=nb-common.sh
. "$(dirname "${BASH_SOURCE[0]}")/nb-common.sh"

case "${1:-}" in
  -h | --help)
    nb_usage "$0"
    exit 0
    ;;
esac

nb_need docker jq
nb_check_project_name
nb_init_dirs

case "$(basename "$0")" in
  nb-unhold) mode=unhold ;;
  *) mode=hold ;;
esac
[ "$mode" = hold ] && [ "${1:-}" = "--unhold" ] && mode=unhold

# kill, not stop: the API holds no state, its entrypoint script ignores SIGTERM, and in an incident
# every second a stop would wait is a second the node is still answering. A reload in flight can
# start the API between our kill and our exit, so this is not done until the container is seen not
# running. Returns 1 if it is still running after 10 seconds.
kill_api_until_down() {
  local _ api_id
  for _ in $(seq 1 20); do
    nb_compose kill api >/dev/null 2>&1 || true
    api_id="$(nb_container_id api)"
    if [ -z "$api_id" ] || [ "$(docker inspect -f '{{.State.Running}}' "$api_id" 2>/dev/null)" != true ]; then
      return 0
    fi
    sleep 0.5
  done
  return 1
}

if [ "$mode" = hold ]; then
  reason="${*:-no reason given}"
  printf '%s by %s: %s\n' "$(nb_ts)" "${SUDO_USER:-${USER:-unknown}}" "$reason" | nb_write_atomic "$NB_STATE_DIR/hold"
  nb_log "hold flag written; stopping the node API container"
  if kill_api_until_down; then
    nb_log "node is OUT of the federation: $(cat "$NB_STATE_DIR/hold")"
    exit 0
  fi
  nb_die 9 "the hold flag is written, but the API container is still running after 10 seconds; run: docker kill $(nb_container_id api)"
fi

# unhold
if [ ! -f "$NB_STATE_DIR/hold" ]; then
  nb_log "the node is not on hold"
  exit 0
fi
held_text="$(cat "$NB_STATE_DIR/hold")"
nb_log "ending hold: $held_text"

# Takes the hold flag away only if it is still the one this unhold read. `nb hold` can run again
# while the reload below is working (it takes no lock, on purpose), and that newer hold is not ours
# to end. The flag is renamed away first so that nothing can be written between the look and the
# removal; a newer one is put back (unless an even newer one has appeared).
end_this_hold() {
  local flag="$NB_STATE_DIR/hold" taken="$NB_STATE_DIR/hold.taken.$$" now
  mv "$flag" "$taken" 2>/dev/null || return 0
  now="$(cat "$taken")"
  if [ "$(nb_decide_unhold_flag "$held_text" "$now")" = remove ]; then
    rm -f "$taken"
    return 0
  fi
  ln "$taken" "$flag" 2>/dev/null || true
  rm -f "$taken"
  return 1
}

# A newer hold set during the work: the API this unhold started is killed again, and the node stays
# on hold under the newer text.
newer_hold_wins() {
  nb_log "a newer hold was set while the node was coming back ($(cat "$NB_STATE_DIR/hold" 2>/dev/null)); the API is stopped again and the node stays on hold"
  kill_api_until_down || true
}

# The flag stays until the node is verified, so a failure here leaves it on hold, not half back.
if [ -f "$NB_STATE_DIR/pending-reload" ]; then
  nb_log "a staged release is waiting; reloading it first (the API is started only once the graph holds it)"
  rc=0
  NB_ENDING_HOLD="$held_text" "$NB_CODE_DIR/bin/nb-reload" --from-unhold || rc=$?
  if [ "$rc" -eq 0 ]; then
    if end_this_hold; then
      nb_log "node is back in the federation"
    else
      newer_hold_wins
      exit "$NB_EX_HOLD"
    fi
  else
    nb_log "ERROR: the reload failed (exit $rc); the node stays on hold"
  fi
  exit "$rc"
fi
# docker start, not compose start: compose would also start the init container the API depends on,
# which rewrites the shared data volume.
docker start "$(nb_container_id api)" >/dev/null
for _ in $(seq 1 60); do
  [ "$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$(nb_container_id api)" 2>/dev/null)" = healthy ] && break
  sleep 3
done
rel="$(nb_current_release)"
if nb_verify_node "$rel"; then
  # A reload that a hold interrupted is on record as failed. Putting the node back is a successful
  # verification of the same release, so it is recorded too, or nb status would go on reporting the
  # interrupted reload as the last word.
  jq -cn --arg at "$(nb_ts)" --arg release "$rel" \
    --argjson expected "$NB_VERIFY_EXPECTED" --argjson served "$NB_VERIFY_SERVED" \
    '{at:$at, kind:"unhold", release:$release, ok:true, reason:"",
      seconds:{init:0, graph:0, api:0, verify:0, total:0},
      datasets_expected:$expected, datasets_served:$served}' >>"$NB_STATE_DIR/reload-history.jsonl"
  # The graph may have restarted for a reload the hold interrupted; it holds this release, so the
  # restart count that nb status compares against is brought up to date.
  if [ -f "$NB_STATE_DIR/applied.json" ]; then
    jq --argjson r "$(docker inspect -f '{{.RestartCount}}' "$(nb_container_id graph)" 2>/dev/null || echo 0)" \
      '.graph_restarts = $r' "$NB_STATE_DIR/applied.json" | nb_write_atomic "$NB_STATE_DIR/applied.json" || true
  fi
  if end_this_hold; then
    nb_log "node is back in the federation: $NB_VERIFY_SERVED dataset(s) served"
  else
    newer_hold_wins
    exit "$NB_EX_HOLD"
  fi
else
  nb_compose kill api >/dev/null 2>&1 || true
  nb_die "$NB_EX_PREFLIGHT" "the API came up but verification failed ($NB_VERIFY_REASON); it was stopped again and the node stays on hold"
fi
