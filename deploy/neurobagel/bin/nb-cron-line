#!/usr/bin/env bash
#
# nb-cron-line: print the crontab entries for this node. It installs nothing: the crontab belongs
# to the account that owns it, and adding a line is a decision for a person.
#
# Usage: bin/nb-cron-line
set -euo pipefail
# shellcheck source=nb-common.sh
. "$(dirname "${BASH_SOURCE[0]}")/nb-common.sh"
cat <<LINES
# NEMAR Neurobagel node (crontab -e). Host local time.
# Pull artifacts and reload ONLY when something changed. Cheap when nothing did: one small index fetch.
*/20 * * * * $NB_CODE_DIR/bin/nb load >> $NB_LOGS_DIR/load.log 2>&1
# Resource guard: log a sample and stop this project (only) if host memory available falls below the threshold.
*/5 * * * * $NB_CODE_DIR/bin/nb guard --quiet --abort-on mem >> $NB_LOGS_DIR/guard-cron.log 2>&1
# Nightly backup of inputs and state, 14 kept.
17 3 * * * $NB_CODE_DIR/bin/nb backup >> $NB_LOGS_DIR/backup.log 2>&1
LINES
