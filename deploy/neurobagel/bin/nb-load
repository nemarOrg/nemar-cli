#!/usr/bin/env bash
#
# nb-load: the pull loader. Fetches the artifact index from the configured source, downloads
# only what changed, verifies every file, assembles a complete new release directory, and (unless
# told not to) hands it to nb-reload for a deliberate, measured reload of the graph.
#
# The source is the private artifact store Phase 4 provides. Until it exists, point NB_SOURCE at
# a local directory that holds an index.json and the files it lists. The format of the index is
# index.schema.json; README.md, "Artifact store interface", explains it for the producer.
#
# Guarantees:
#   * The live input directory (data/current) is only ever swapped to a COMPLETE, verified
#     release by one rename(2). A failed run leaves it exactly as it was, with no residue.
#   * Two loaders, or a loader and a reload, can never overlap (flock on state/lock).
#   * A dataset that disappears from the index disappears from the next release. That is how an
#     ineligible dataset leaves the federation. Emptying the node by accident is refused.
#   * Nothing the source sends can make the host work without bound: the index, each artifact, the
#     total and the number of datasets are capped, and free disk is checked first.
#
# Usage: bin/nb-load [--source SRC] [--force] [--no-reload] [--dry-run]
#                    [--allow-mass-removal] [--seed-example] [--thaw]
#   --source SRC          https URL or a local directory; default NB_SOURCE from .env
#   --force               build and reload a release even when nothing changed, retry content that
#                         failed to reload before, and load while frozen
#   --no-reload           stage the release and swap data/current, but do not touch the graph;
#                         run bin/nb-reload when ready (also: NB_RELOAD=0)
#   --dry-run             fetch the index, print the plan as JSON, change nothing
#   --allow-mass-removal  accept an index that drops more than half of at least ten datasets
#   --thaw                end a freeze set by `nb rollback` and exit
#   --seed-example        first-install helper: make the first release from Neurobagel's example
#                         JSON-LD in the recipes checkout. Never reloads.
#
# Environment (defaults in brackets): NB_SOURCE; NB_ALLOW_HTTP (unset; plain http is refused
# unless this is 1, for tests and local development); NB_SOURCE_AUTH_HEADER_FILE; NB_VALIDATE
# (docker, jq or none; docker when the stack is installed, else jq); the caps NB_MAX_INDEX_BYTES
# [8 MiB], NB_MAX_ARTIFACT_BYTES [6 MiB], NB_MAX_TOTAL_BYTES [192 MiB], NB_MIN_FREE_DISK_MB
# [2048] (the dataset cap comes from index.schema.json); NB_FETCH_TIMEOUT_S [300] for one request
# and NB_LOAD_BUDGET_S [900] for the whole run, retries included; NB_INIT_MEM_LIMIT [160m] for the
# validator container; NB_KEEP_RELEASES [4]; NB_RELOAD [1]; NB_KNOWN_BAD_TTL_S [21600].
# A redirect from the source is refused: the index and every artifact must be served directly.
#
# Exit codes: 0 ok or nothing to do; 3 source unreadable, invalid or over a cap; 4 validation
# failed; 5 reload failed and was rolled back; 6 reload failed and rollback failed; 7 node on hold;
# 8 pre-flight refused (disk); 75 another loader or reload is running; 78 configuration.

set -euo pipefail
# shellcheck source=nb-common.sh
. "$(dirname "${BASH_SOURCE[0]}")/nb-common.sh"

source_arg=""
force=0
reload="$(nb_env_get NB_RELOAD 1)"
dry_run=0
allow_mass_removal=0
seed_example=0
thaw=0

while [ $# -gt 0 ]; do
  case "$1" in
    --source)
      [ $# -ge 2 ] || nb_die "$NB_EX_USAGE" "--source needs a value"
      source_arg="$2"
      shift 2
      ;;
    --force) force=1; shift ;;
    --no-reload) reload=0; shift ;;
    --dry-run) dry_run=1; shift ;;
    --allow-mass-removal) allow_mass_removal=1; shift ;;
    --seed-example) seed_example=1; shift ;;
    --thaw) thaw=1; shift ;;
    -h | --help)
      nb_usage "$0"
      exit 0
      ;;
    *) nb_die "$NB_EX_USAGE" "unknown argument: $1 (see --help)" ;;
  esac
done

nb_need jq curl perl
nb_init_dirs

if [ "$thaw" = 1 ]; then
  if [ -f "$NB_STATE_DIR/freeze" ]; then
    nb_log "ending freeze: $(cat "$NB_STATE_DIR/freeze")"
    rm -f "$NB_STATE_DIR/freeze"
  else
    nb_log "the loader is not frozen"
  fi
  exit 0
fi
nb_rotate_log "$NB_LOGS_DIR/load.log"

max_index_bytes="$(nb_env_get NB_MAX_INDEX_BYTES 8388608)"
# 6 MiB per artifact: the largest real dataset document measured is 0.44 MB (14 times under the cap),
# and the stock validator holds a document in memory at 12 to 14 times its size (measured: 8.06 MB
# needs 104 MiB and 10.9 MB needs 160 MiB), so 6 MiB needs about 90 MiB of the 160 MiB validator
# limit (NB_INIT_MEM_LIMIT). Raise the two together.
max_artifact_bytes="$(nb_env_get NB_MAX_ARTIFACT_BYTES 6291456)"
# 192 MiB in all: the largest release the 2 GiB graph container was measured to load is 172 MB of
# JSON-LD (3.56 million statements, 1.57 GiB peak); the planned scale is about 70 MB.
max_total_bytes="$(nb_env_get NB_MAX_TOTAL_BYTES 201326592)"
min_free_disk_mb="$(nb_env_get NB_MIN_FREE_DISK_MB 2048)"
fetch_timeout="$(nb_env_get NB_FETCH_TIMEOUT_S 300)"
# The whole run, retries included, ends by this many seconds after it began. Without it, 3 retries of
# a 300 s timeout per artifact is no bound at all.
load_budget_s="$(nb_env_get NB_LOAD_BUDGET_S 900)"
keep_releases="$(nb_env_get NB_KEEP_RELEASES 4)"
auth_file="$(nb_env_get NB_SOURCE_AUTH_HEADER_FILE "")"
user_agent="nemar-neurobagel-loader/1.0"
started_epoch="$(nb_epoch)"
load_deadline=$((started_epoch + load_budget_s))

if [ "$dry_run" = 0 ]; then
  nb_lock_or_exit "nb-load"
fi

stage=""
warnings_file=""
# shellcheck disable=SC2329  # invoked through the EXIT trap
cleanup() {
  [ -z "$stage" ] || rm -rf "$stage"
  [ -z "$warnings_file" ] || rm -f "$warnings_file"
  nb_lock_release
}
trap cleanup EXIT

if [ "$dry_run" = 0 ]; then
  # Under the lock nobody else is staging, so anything left behind by a run that was killed (a
  # SIGKILL runs no trap) is garbage.
  rm -rf "${NB_DATA_DIR:?}"/.stage.* 2>/dev/null || true
  rm -f "${NB_STATE_DIR:?}"/.warnings.* 2>/dev/null || true
  # Temp files of the writers that take no lock (nb hold, the guard) are only swept once a minute
  # old: a younger one may be mid-write, and removing it would abort that write.
  find "$NB_STATE_DIR" -maxdepth 1 -name '*.tmp.*' -mmin +1 -exec rm -f {} + 2>/dev/null || true
fi

warnings_file="$NB_STATE_DIR/.warnings.$$"
: >"$warnings_file"
warn() {
  nb_log "WARNING: $*"
  printf '%s\n' "$*" >>"$warnings_file"
}

# jq on a file the source supplied runs with a bounded address space where the platform allows it
# (Linux), so a document that expands badly in memory fails the check instead of the host.
bounded_jq() {
  (
    ulimit -v "$(nb_env_get NB_JQ_MAX_KB 1048576)" 2>/dev/null || true
    exec jq "$@"
  )
}

# ---------------------------------------------------------------------------------------------
# The source. Sanitised before it is recorded anywhere; credentials in it are refused.
# ---------------------------------------------------------------------------------------------
source=""
source_label=""
resolve_source() {
  local raw="$1" rest
  case "$raw" in
    http://* | https://*)
      rest="${raw#*://}"
      case "${rest%%/*}" in
        *@*) nb_die "$NB_EX_CONFIG" "the source URL carries credentials (user:password@host); put a token in NB_SOURCE_AUTH_HEADER_FILE instead" ;;
      esac
      if [ "${raw#https://}" = "$raw" ] && [ "$(nb_env_get NB_ALLOW_HTTP 0)" != 1 ]; then
        nb_die "$NB_EX_CONFIG" "the source must be https (plain http only with NB_ALLOW_HTTP=1, for tests and local development)"
      fi
      source="$raw"
      # Query strings and fragments can carry a presigned token: never record them.
      source_label="${raw%%[?#]*}"
      ;;
    *)
      source="${raw#file://}"
      [ -d "$source" ] || nb_die "$NB_EX_CONFIG" "the source directory does not exist: $source"
      source_label="$source"
      ;;
  esac
}

# Record how the run ended. Called on every exit path that has a decision to report.
write_last_load() { # outcome release extra-json
  local outcome="$1" release="${2:-}" extra="${3:-}"
  [ -n "$extra" ] || extra='{}'
  [ "$dry_run" = 0 ] || return 0
  jq -n \
    --arg at "$(nb_ts)" --arg outcome "$outcome" --arg release "$release" \
    --arg source "$source_label" --argjson seconds "$(($(nb_epoch) - started_epoch))" \
    --argjson extra "$extra" \
    --slurpfile warnings <(jq -R . "$warnings_file") \
    '{at:$at, outcome:$outcome, release:$release, source:$source, seconds:$seconds,
      warnings:$warnings} + $extra' | nb_write_atomic "$NB_STATE_DIR/last-load.json"
  # A run that ended well, including one that found nothing to do, is what "the loader is alive"
  # means. nb-status alarms when this is old.
  case "$outcome" in
    unchanged | staged | reloaded | seeded) nb_epoch | nb_write_atomic "$NB_STATE_DIR/last-load-ok" ;;
  esac
}

# ---------------------------------------------------------------------------------------------
# Fetching. Both source kinds hand back a file at DEST or fail; nothing else is promised.
# ---------------------------------------------------------------------------------------------
fetch() { # base rel dest max_bytes
  local base="$1" rel="$2" dest="$3" max="$4" url remaining timeout_s budget_bound code rc=0
  local -a hdr=()
  case "$base" in
    http://* | https://*)
      url="${base%/}/$rel"
      remaining=$((load_deadline - $(nb_epoch)))
      if [ "$remaining" -le 0 ]; then
        nb_log "the loader's time budget (NB_LOAD_BUDGET_S=$load_budget_s) ran out before $rel was fetched"
        return 1
      fi
      timeout_s="$fetch_timeout"
      budget_bound=0
      if [ "$remaining" -lt "$timeout_s" ]; then
        timeout_s="$remaining"
        budget_bound=1
      fi
      if [ -n "$auth_file" ]; then
        [ -r "$auth_file" ] || { nb_log "auth header file is not readable: $auth_file"; return 1; }
        hdr=(-H "@$auth_file")
      fi
      # No --location: a redirect is never followed. curl would send a non-Authorization credential
      # header on to the redirect target, and an index or artifact URL is ours to name, so it must
      # answer directly. --fail makes 4xx and 5xx failures; a 3xx is checked by hand below.
      code="$(curl --fail --silent --show-error --proto '=http,https' \
        --retry 3 --retry-delay 2 --retry-connrefused --retry-max-time "$remaining" --connect-timeout 15 \
        --max-time "$timeout_s" --max-filesize "$max" \
        -A "$user_agent" ${hdr[@]+"${hdr[@]}"} -o "$dest" -w '%{http_code}' "$url")" || rc=$?
      if [ "$rc" -ne 0 ]; then
        if [ "$budget_bound" = 1 ] || [ "$(nb_epoch)" -ge "$load_deadline" ]; then
          nb_log "the request for $rel failed within the loader's time budget (NB_LOAD_BUDGET_S=$load_budget_s), which cut it short"
        fi
        rm -f "$dest"
        return 1
      fi
      case "$code" in
        200) ;;
        3??)
          nb_log "refused a redirect (HTTP $code) for $rel: the index and every artifact must be served directly"
          rm -f "$dest"
          return 1
          ;;
        *)
          nb_log "unexpected HTTP $code for $rel"
          rm -f "$dest"
          return 1
          ;;
      esac
      ;;
    *)
      [ -f "$base/$rel" ] || { nb_log "not found in source directory: $rel"; return 1; }
      cp "$base/$rel" "$dest"
      ;;
  esac
}

file_bytes() { wc -c <"$1" | tr -d ' '; }

# ---------------------------------------------------------------------------------------------
# Index validation. The constants come from index.schema.json, the one definition of the format;
# what a JSON Schema cannot say (name equals id plus a per-kind suffix, one JSON-LD per dataset,
# uniqueness) is written here and tested against the schema for drift.
# ---------------------------------------------------------------------------------------------
# The program prints a JSON array of what is wrong, one sentence each, empty when nothing is. Every
# rule has its own sentence, so a test can show each one firing on its own and the operator can see
# which rule an index broke. A newline is refused in every string because jq's `$` also matches
# before a trailing newline.
# shellcheck disable=SC2016  # the $-names below are jq variables, not shell expansions
INDEX_PROBLEMS='
  def full($p): type == "string" and test($p) and (contains("\n") | not);
  def q: tostring | .[0:60] | @json;
  def okid: full($c.idpat) and (contains("..") | not);
  def okname: full($c.namepat) and (contains("..") | not);
  if type != "object" then ["the index is not a JSON object"] else
  . as $r
  | [
      (if $r.schema == $c.schema then empty else "schema is not \($c.schema | @json)" end),
      (if ($r.generated_at | full($c.gatpat)) then empty else "generated_at is missing or not a UTC timestamp" end),
      (if ($r.datasets | type) != "array" then "datasets is not a list"
       elif ($r.datasets | length) > $c.maxdatasets then "more than \($c.maxdatasets) datasets"
       else empty end),
      (if ($r.datasets | type) == "array" then
         ($r.datasets | to_entries[] | .key as $i | .value as $d
          | if ($d | type) != "object" then "dataset #\($i) is not an object"
            else
              (if ($d.id | okid) then empty else "dataset #\($i): id \($d.id | q) is not allowed" end),
              (if ($d.fingerprint | full($c.fppat)) then empty
               else "dataset \($d.id | q): fingerprint is not sha256: and 64 hex digits" end),
              (if ($d.artifacts | type) != "array" then "dataset \($d.id | q): artifacts is not a list"
               else
                 (if ($d.artifacts | length) < 1 then "dataset \($d.id | q): no artifacts" else empty end),
                 (if ($d.artifacts | length) > $c.maxartifacts
                  then "dataset \($d.id | q): more than \($c.maxartifacts) artifacts" else empty end),
                 ($d.artifacts | to_entries[] | .key as $j | .value as $a
                  | if ($a | type) != "object" then "dataset \($d.id | q): artifact #\($j) is not an object"
                    else
                      (if ($a.name | okname) then empty
                       else "dataset \($d.id | q): artifact name \($a.name | q) is not allowed" end),
                      (if (($a.kind as $k | $c.kinds | index($k)) != null) then empty
                       else "dataset \($d.id | q): artifact kind \($a.kind | q) is unknown" end),
                      (if ($a.sha256 | full($c.shapat)) then empty
                       else "dataset \($d.id | q): artifact \($a.name | q) has no valid sha256" end),
                      (if (($a.bytes // 1) | type == "number" and . >= 1 and floor == .) then empty
                       else "dataset \($d.id | q): artifact \($a.name | q) bytes is not a whole number of at least 1" end),
                      (if ($d.id | type) == "string" and ($a.kind | type) == "string" and ($c.suffix[$a.kind] != null)
                          and $a.name == ($d.id + $c.suffix[$a.kind]) then empty
                       else "dataset \($d.id | q): artifact \($a.name | q) is not the id plus the suffix of its kind" end)
                    end),
                 (if ([$d.artifacts[] | select(type == "object" and .kind == "jsonld")] | length) == 1 then empty
                  else "dataset \($d.id | q): needs exactly one jsonld artifact" end)
               end)
            end)
       else empty end),
      (if ($r.datasets | type) == "array" then
         ([$r.datasets[] | select(type == "object") | .id | tostring] as $ids
          | if ($ids | length) == ($ids | unique | length) then empty else "dataset ids are not unique" end)
       else empty end),
      (if ($r.datasets | type) == "array" then
         ([$r.datasets[] | select(type == "object") | .artifacts | select(type == "array") | .[] | select(type == "object") | .name | tostring] as $ns
          | if ($ns | length) == ($ns | unique | length) then empty else "artifact names are not unique across the index" end)
       else empty end)
    ]
  end
'

# shellcheck disable=SC2016
CONTRACT_PROGRAM='{
  schema: .properties.schema.const,
  gatpat: .properties.generated_at.pattern,
  maxdatasets: .properties.datasets.maxItems,
  idpat: .definitions.id.pattern,
  fppat: .definitions.dataset.properties.fingerprint.pattern,
  maxartifacts: .definitions.dataset.properties.artifacts.maxItems,
  namepat: .definitions.artifact.properties.name.pattern,
  kinds: .definitions.artifact.properties.kind.enum,
  shapat: .definitions.sha256.pattern,
  suffix: ."x-rules".artifactSuffix
}'

# Normalised view of an index: {id: {fingerprint, artifacts: {name: {kind, sha256, bytes}}}}.
# shellcheck disable=SC2016
NORMALISE='
  .datasets | map({key: .id, value: {
      fingerprint: .fingerprint,
      artifacts: (.artifacts | map({key: .name, value: {kind: .kind, sha256: .sha256, bytes: (.bytes // null)}}) | from_entries)
  }}) | from_entries
'

# ---------------------------------------------------------------------------------------------
# Candidate validation: what the stock stack will do with the files, checked before any of it
# is allowed near the graph.
# ---------------------------------------------------------------------------------------------
validate_candidate() { # dir expected_jsonld_count
  local dir="$1" expected="$2" mode f idfile dups
  mode="$(nb_env_get NB_VALIDATE "")"
  if [ -z "$mode" ]; then
    if command -v docker >/dev/null 2>&1 && [ -f "$NB_RECIPES_DIR/docker-compose.yml" ] \
      && docker image inspect "$NB_PROJECT-init_data" >/dev/null 2>&1; then
      mode=docker
    else
      mode=jq
    fi
  fi
  nb_log "validating $expected JSON-LD file(s), mode=$mode"
  [ "$mode" != none ] || { warn "validation disabled (NB_VALIDATE=none)"; return 0; }

  # Structure every file must have, in any mode. A duplicate dataset identifier is checked here
  # because the stock initialiser silently keeps only one of two datasets with the same id.
  idfile="$stage/identifiers.txt"
  : >"$idfile"
  for f in "$dir"/*.jsonld; do
    [ -e "$f" ] || continue
    # shellcheck disable=SC2016
    bounded_jq -e '
      (.identifier | type == "string" and startswith("nb:"))
      and (.schemaKey == "Dataset")
      and (.hasLabel | type == "string" and length > 0)
      and (.hasSamples | type == "array" and length >= 1)
      and (has("@context"))' "$f" >/dev/null 2>&1 \
      || { nb_log "not a Neurobagel dataset document: $(basename "$f")"; return 1; }
    bounded_jq -r .identifier "$f" >>"$idfile"
  done
  dups="$(sort "$idfile" | uniq -d)"
  [ -z "$dups" ] || { nb_log "duplicate dataset identifier(s) across files: $dups"; return 1; }

  [ "$mode" = docker ] || return 0

  local out log img n_ok n_all counts
  out="$stage/validate-out"
  log="$stage/validate.log"
  mkdir -p "$out"
  img="$NB_PROJECT-init_data"
  # The stock validator, on the candidate, in a throwaway container with no network.
  local -a vargs=()
  while IFS= read -r a; do vargs+=("$a"); done < <(nb_validator_args "$img" "$(nb_env_get NB_INIT_MEM_LIMIT 160m)" \
    "$(nb_env_get NB_INIT_CPUS 1.0)" "$(id -u):$(id -g)" "$dir" "$out" "$NB_PROJECT-validate-$$")
  if ! docker "${vargs[@]}" python -m init_data.process_jsonld /input_data /data >"$log" 2>&1; then
    nb_log "the stock validator failed; last lines:"
    tail -n 15 "$log" >&2
    return 1
  fi
  counts="$(nb_init_counts <"$log")"
  n_ok="${counts%% *}"
  n_all="${counts##* }"
  if [ -z "$n_ok" ] || [ "$n_ok" != "$n_all" ] || [ "$n_ok" != "$expected" ]; then
    nb_log "stock validator accepted ${n_ok:-?} of ${n_all:-?} file(s); expected $expected"
    grep -A40 'failed validation' "$log" >&2 || tail -n 25 "$log" >&2
    return 1
  fi
  return 0
}

# ---------------------------------------------------------------------------------------------
# Publication: one rename of the directory, one rename of the symlink.
# ---------------------------------------------------------------------------------------------
# Identity of a release's CONTENT: the sorted list of dataset/artifact/sha256, hashed. Two indexes
# with the same content give the same id whatever their fingerprints or timestamps say.
content_id_of() { # normalised_json_file
  jq -r 'to_entries | map(.key as $id | .value.artifacts | to_entries | map("\($id)/\(.key)/\(.value.sha256)")) | flatten | sort | join("\n")' "$1" \
    | nb_sha256_stdin
}

# Every step is checked explicitly: errexit does not reach into a command substitution on bash 3.2,
# and an earlier version of this function published a release with an EMPTY manifest because a
# jq call failed on a long argument list (found by the 800-dataset trial). The big JSON therefore
# travels in files, never in arguments, and nothing empty is ever installed.
PUBLISHED_RELEASE=""
publish_release() { # candidate_dir normalised_json_file source_label index_generated_at
  local cand="$1" normfile="$2" label="$3" generated="$4" content_id name base n prev manifest
  content_id="$(content_id_of "$normfile")" || return 1
  [ -n "$content_id" ] || return 1
  name="$(date -u +%Y%m%dT%H%M%SZ)-${content_id:0:8}"
  # The same content published twice within one second (a forced retry) must not collide: mv
  # would move the new directory INTO the old one.
  base="$name"
  n=1
  while [ -e "$NB_RELEASES_DIR/$name" ]; do
    n=$((n + 1))
    name="${base}-$n"
  done
  prev="$(nb_current_release || true)"
  manifest="$NB_MANIFESTS_DIR/$name.json"
  jq -n --arg name "$name" --arg created "$(nb_ts)" --arg source "$label" \
    --arg generated "$generated" --arg content "$content_id" --slurpfile datasets "$normfile" \
    '$datasets[0] as $d
     | {schema: "nemar-neurobagel-release/1", name: $name, created_at: $created, source: $source,
        index_generated_at: $generated, content_id: $content, datasets: $d,
        counts: {datasets: ($d | length),
                 artifacts: ([$d[].artifacts | length] | add // 0),
                 bytes: ([$d[].artifacts[].bytes // 0] | add // 0)}}' >"$manifest.tmp.$$" \
    || { rm -f "$manifest.tmp.$$"; return 1; }
  [ -s "$manifest.tmp.$$" ] || { rm -f "$manifest.tmp.$$"; return 1; }
  mv -f "$manifest.tmp.$$" "$manifest" || return 1
  mv "$cand" "$NB_RELEASES_DIR/$name" || return 1
  nb_atomic_symlink "releases/$name" "$NB_CURRENT_LINK" || return 1
  printf '%s\n' "$name" | nb_write_atomic "$NB_STATE_DIR/pending-reload" || return 1
  if [ -n "$prev" ] && [ "$prev" != "$name" ]; then
    printf '%s\n' "$prev" | nb_write_atomic "$NB_STATE_DIR/rollback-to" || return 1
  fi
  PUBLISHED_RELEASE="$name"
}

# Release directories are kept newest first up to NB_KEEP_RELEASES, but never the live one, the
# one a failed reload would return to (the last release that was loaded and verified), or the
# release loaded before that.
prune_releases() {
  local keep="$keep_releases" n=0 name protected
  protected="$(nb_current_release || true) $(cat "$NB_STATE_DIR/rollback-to" 2>/dev/null || true) $(cat "$NB_STATE_DIR/previous-loaded" 2>/dev/null || true)"
  if [ -f "$NB_STATE_DIR/applied.json" ]; then
    protected="$protected $(jq -r '.release // ""' "$NB_STATE_DIR/applied.json" 2>/dev/null || true)"
  fi
  # Release names start with a UTC timestamp, so reverse lexical order is newest first.
  for name in $(find "$NB_RELEASES_DIR" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort -r); do
    n=$((n + 1))
    [ "$n" -gt "$keep" ] || continue
    case " $protected " in *" $name "*) continue ;; esac
    rm -rf "${NB_RELEASES_DIR:?}/$name" "$NB_MANIFESTS_DIR/$name.json"
    nb_log "pruned release $name"
  done
}

free_disk_mb() { df -Pk "$NB_DATA_DIR" | awk 'NR == 2 { printf "%d", $4 / 1024 }'; }

# ---------------------------------------------------------------------------------------------
# Seed
# ---------------------------------------------------------------------------------------------
if [ "$seed_example" = 1 ]; then
  example="$NB_RECIPES_DIR/data/example_synthetic_pheno-bids-derivatives.jsonld"
  [ -f "$example" ] || nb_die "$NB_EX_PREFLIGHT" "recipes example not found: $example (run nb-install first)"
  [ ! -L "$NB_CURRENT_LINK" ] || nb_die "$NB_EX_USAGE" "a release is already live: $(nb_current_release)"
  source_label="recipes-example"
  stage="$(mktemp -d "$NB_DATA_DIR/.stage.XXXXXX")"
  mkdir "$stage/release"
  cp "$example" "$stage/release/recipes-example.jsonld"
  validate_candidate "$stage/release" 1 || nb_die "$NB_EX_VALIDATE" "the recipes example failed validation"
  sha="$(nb_sha256 "$stage/release/recipes-example.jsonld")"
  bytes="$(file_bytes "$stage/release/recipes-example.jsonld")"
  jq -n --arg sha "$sha" --argjson bytes "$bytes" \
    '{"recipes-example": {fingerprint: "recipes-example", artifacts: {"recipes-example.jsonld": {kind: "jsonld", sha256: $sha, bytes: $bytes}}}}' \
    >"$stage/new.json"
  publish_release "$stage/release" "$stage/new.json" "recipes-example" "" || nb_die 1 "could not publish the seed release"
  name="$PUBLISHED_RELEASE"
  # Nothing is loaded yet, so there is nothing to reload or roll back to.
  rm -f "$NB_STATE_DIR/pending-reload" "$NB_STATE_DIR/rollback-to"
  write_last_load seeded "$name" '{}'
  nb_log "seeded release $name from Neurobagel's example JSON-LD"
  exit 0
fi

# ---------------------------------------------------------------------------------------------
# Normal run
# ---------------------------------------------------------------------------------------------
raw_source="${source_arg:-$(nb_env_get NB_SOURCE "")}"
[ -n "$raw_source" ] || nb_die "$NB_EX_CONFIG" "no source: set NB_SOURCE in .env or pass --source"
resolve_source "$raw_source"

# Any permission bit for group or others (find's -perm differs between GNU and BSD, perl does not).
if [ -n "$auth_file" ] && [ -e "$auth_file" ] && perl -e 'exit(((stat $ARGV[0])[2] & 077) ? 0 : 1)' "$auth_file"; then
  warn "the auth header file $auth_file is readable by other accounts; it should be mode 600"
fi

if [ -f "$NB_STATE_DIR/freeze" ] && [ "$force" = 0 ] && [ "$dry_run" = 0 ]; then
  nb_log "loader is frozen ($(cat "$NB_STATE_DIR/freeze")); nothing fetched. End it with: nb load --thaw"
  write_last_load frozen "$(nb_current_release || true)" '{}'
  exit 0
fi

if nb_hold_active && [ "$dry_run" = 0 ]; then
  nb_log "node is on hold ($(cat "$NB_STATE_DIR/hold")); fetching and staging only, no reload"
  reload=0
fi

if [ "$dry_run" = 0 ]; then
  free_mb="$(free_disk_mb)"
  if [ -n "$free_mb" ] && [ "$free_mb" -lt "$min_free_disk_mb" ]; then
    write_last_load source-failed "" '{"reason":"low disk"}'
    nb_die "$NB_EX_PREFLIGHT" "only ${free_mb} MiB of disk is free where the releases live; the floor is ${min_free_disk_mb} MiB (NB_MIN_FREE_DISK_MB)"
  fi
fi

stage="$(mktemp -d "$NB_DATA_DIR/.stage.XXXXXX")"

nb_log "reading index from $source_label"
if ! fetch "$source" index.json "$stage/index.json" "$max_index_bytes"; then
  write_last_load source-failed "" '{"reason":"index unreadable"}'
  nb_die "$NB_EX_SOURCE" "could not read index.json from the source"
fi
if [ "$(file_bytes "$stage/index.json")" -gt "$max_index_bytes" ]; then
  write_last_load source-failed "" '{"reason":"index too large"}'
  nb_die "$NB_EX_SOURCE" "index.json is larger than NB_MAX_INDEX_BYTES ($max_index_bytes)"
fi
contract="$(jq -c "$CONTRACT_PROGRAM" "$NB_SCHEMA_FILE")" || nb_die "$NB_EX_CONFIG" "index.schema.json is unreadable"
if ! index_problems="$(bounded_jq -r --argjson c "$contract" "$INDEX_PROBLEMS | .[]" "$stage/index.json" 2>/dev/null)" \
  || [ -n "$index_problems" ]; then
  [ -n "$index_problems" ] || index_problems="index.json is not valid JSON"
  # sed, not head: head closes the pipe early and printf would die of SIGPIPE under pipefail.
  printf '%s\n' "$index_problems" | sed -n '1,10p' | while IFS= read -r line; do nb_log "index: $line"; done
  write_last_load source-failed "" '{"reason":"index invalid"}'
  nb_die "$NB_EX_SOURCE" "index.json does not satisfy the interface (index.schema.json; README, \"Artifact store interface\")"
fi
generated="$(jq -r '.generated_at // ""' "$stage/index.json")"
jq "$NORMALISE" "$stage/index.json" >"$stage/new.json"

# The total the index promises (where it states sizes) is checked before anything is downloaded.
promised_bytes="$(jq '[.[] | .artifacts[] | .bytes // 0] | add // 0' "$stage/new.json")"
if [ "$promised_bytes" -gt "$max_total_bytes" ]; then
  write_last_load source-failed "" '{"reason":"over the total size cap"}'
  nb_die "$NB_EX_SOURCE" "the index promises $promised_bytes bytes in all, over NB_MAX_TOTAL_BYTES ($max_total_bytes)"
fi

cur="$(nb_current_release || true)"
if [ -n "$cur" ] && [ -f "$NB_MANIFESTS_DIR/$cur.json" ]; then
  jq -e '.datasets | type == "object"' "$NB_MANIFESTS_DIR/$cur.json" >/dev/null 2>&1 \
    || nb_die 1 "the manifest of the live release $cur is unreadable ($NB_MANIFESTS_DIR/$cur.json); move it aside and run again with --force"
  jq '{datasets: .datasets, source: .source}' "$NB_MANIFESTS_DIR/$cur.json" >"$stage/old.json"
else
  echo '{"datasets":{},"source":""}' >"$stage/old.json"
fi

# shellcheck disable=SC2016
jq -n --slurpfile n "$stage/new.json" --slurpfile o "$stage/old.json" '
  ($n[0]) as $new | ($o[0].datasets) as $old
  | def shas($d): $d.artifacts | map_values(.sha256);
  { added:     [$new | keys[] | select(. as $k | $old | has($k) | not)],
    removed:   [$old | keys[] | select(. as $k | $new | has($k) | not)],
    changed:   [$new | keys[] | select(. as $k | ($old | has($k)) and (shas($old[$k]) != shas($new[$k])))],
    unchanged: [$new | keys[] | select(. as $k | ($old | has($k)) and (shas($old[$k]) == shas($new[$k])))],
    stale_fingerprint: [$new | keys[] | select(. as $k | ($old | has($k))
                         and ($old[$k].fingerprint == $new[$k].fingerprint)
                         and (shas($old[$k]) != shas($new[$k])))],
    new_count: ($new | length), old_count: ($old | length) }' >"$stage/plan.json"

n_new="$(jq .new_count "$stage/plan.json")"
n_old="$(jq .old_count "$stage/plan.json")"
n_added="$(jq '.added | length' "$stage/plan.json")"
n_removed="$(jq '.removed | length' "$stage/plan.json")"
n_changed="$(jq '.changed | length' "$stage/plan.json")"
plan_summary="$(jq -c '{datasets: .new_count, added: (.added | length), removed: (.removed | length),
                        changed: (.changed | length), unchanged: (.unchanged | length)}' "$stage/plan.json")"

if [ "$dry_run" = 1 ]; then
  jq '{plan: ., index_generated_at: $g}' --arg g "$generated" "$stage/plan.json"
  exit 0
fi

# A dataset whose artifacts changed while its fingerprint did not is a producer defect. The
# content (sha256) is the truth, so the change is applied, but it is reported.
for id in $(jq -r '.stale_fingerprint[]' "$stage/plan.json"); do
  warn "dataset $id changed content without changing its fingerprint"
done

if [ "$n_new" -eq 0 ]; then
  write_last_load source-failed "" "$plan_summary"
  nb_die "$NB_EX_SOURCE" "the index lists zero datasets; refusing to empty the node"
fi
# More than half of at least ten datasets disappearing is refused. At exactly half it is allowed:
# the rule is removed * 2 > old.
if [ "$allow_mass_removal" = 0 ] && [ "$n_old" -ge 10 ] && [ "$((n_removed * 2))" -gt "$n_old" ]; then
  write_last_load source-failed "" "$plan_summary"
  nb_die "$NB_EX_SOURCE" "the index drops $n_removed of $n_old datasets; refusing (use --allow-mass-removal if intended)"
fi

pending=""
[ ! -f "$NB_STATE_DIR/pending-reload" ] || pending="$(cat "$NB_STATE_DIR/pending-reload")"

if [ "$((n_added + n_removed + n_changed))" -eq 0 ] && [ "$force" = 0 ]; then
  nb_log "up to date: $n_new dataset(s), release ${cur:-none}"
  if [ -n "$pending" ] && [ "$reload" = 1 ]; then
    nb_log "a staged release is waiting for its reload ($pending); reloading now"
    write_last_load pending-reload "$pending" "$plan_summary"
    rc=0
    "$NB_CODE_DIR/bin/nb-reload" || rc=$?
    [ "$rc" -ne 0 ] || write_last_load reloaded "$pending" "$plan_summary"
    exit "$rc"
  fi
  write_last_load unchanged "${cur:-}" "$plan_summary"
  exit 0
fi

content_probe="$(content_id_of "$stage/new.json")" || nb_die 1 "could not compute the content id"
# Content that failed to reload is not retried for NB_KNOWN_BAD_TTL_S (default 6 hours): long enough
# not to hammer the graph with a bad release every few minutes, short enough that a failure with a
# transient cause (host memory pressure, a restart in the middle) heals itself.
known_bad_ttl="$(nb_env_get NB_KNOWN_BAD_TTL_S 21600)"
if [ "$force" = 0 ] && [ -f "$NB_STATE_DIR/reload-failed" ] \
  && [ "$(jq -r .content_id "$NB_STATE_DIR/reload-failed" 2>/dev/null)" = "$content_probe" ] \
  && [ "$(($(nb_epoch) - $(jq -r '.epoch // 0' "$NB_STATE_DIR/reload-failed")))" -lt "$known_bad_ttl" ]; then
  nb_log "this exact content failed to reload at $(jq -r .at "$NB_STATE_DIR/reload-failed") ($(jq -r .reason "$NB_STATE_DIR/reload-failed" | cut -c1-160)); not retrying for ${known_bad_ttl}s (use --force)"
  write_last_load known-bad "${cur:-}" "$plan_summary"
  exit "$NB_EX_RELOAD"
fi

nb_log "plan: $plan_summary"
cand="$stage/release"
mkdir "$cand"
unchanged_list="$stage/unchanged.txt"
jq -r '.unchanged[]' "$stage/plan.json" >"$unchanged_list"
jq -r 'to_entries[] | .key as $id | .value.artifacts | to_entries[]
       | [$id, .key, .value.sha256, (.value.bytes // "")] | @tsv' "$stage/new.json" >"$stage/files.tsv"

fetched=0
reused=0
bytes_fetched=0
bytes_total=0
source_fail() { # message
  write_last_load source-failed "${cur:-}" "$plan_summary"
  nb_die "$NB_EX_SOURCE" "$1"
}
while IFS=$'\t' read -r id name sha bytes; do
  dest="$cand/$name"
  if grep -qxF "$id" "$unchanged_list" && [ -f "$NB_CURRENT_LINK/$name" ]; then
    ln "$NB_CURRENT_LINK/$name" "$dest" 2>/dev/null || cp -p "$NB_CURRENT_LINK/$name" "$dest"
    reused=$((reused + 1))
    got="$(file_bytes "$dest")"
  else
    tmp="$stage/dl.$$.part"
    rm -f "$tmp"
    if ! fetch "$source" "$name" "$tmp" "$max_artifact_bytes"; then
      source_fail "download failed: $name (live data untouched)"
    fi
    got="$(file_bytes "$tmp")"
    if [ "$got" -eq 0 ] || [ "$got" -gt "$max_artifact_bytes" ]; then
      source_fail "artifact $name has an unacceptable size ($got bytes; the cap is $max_artifact_bytes)"
    fi
    if [ -n "$bytes" ] && [ "$bytes" != "null" ] && [ "$got" != "$bytes" ]; then
      source_fail "artifact $name is $got bytes, the index says $bytes (live data untouched)"
    fi
    mv "$tmp" "$dest"
    fetched=$((fetched + 1))
    bytes_fetched=$((bytes_fetched + got))
  fi
  bytes_total=$((bytes_total + got))
  if [ "$bytes_total" -gt "$max_total_bytes" ]; then
    source_fail "the artifacts add up to more than NB_MAX_TOTAL_BYTES ($max_total_bytes)"
  fi
  actual="$(nb_sha256 "$dest")"
  if [ "$actual" != "$sha" ]; then
    source_fail "sha256 mismatch for $name: index says $sha, file is $actual (live data untouched)"
  fi
done <"$stage/files.tsv"
nb_log "assembled candidate: fetched $fetched file(s) ($bytes_fetched bytes), reused $reused"

n_jsonld="$(jq '[.[] | .artifacts | to_entries[] | select(.value.kind == "jsonld")] | length' "$stage/new.json")"
if ! validate_candidate "$cand" "$n_jsonld"; then
  write_last_load validation-failed "${cur:-}" "$plan_summary"
  nb_die "$NB_EX_VALIDATE" "candidate release failed validation; live data untouched"
fi

publish_release "$cand" "$stage/new.json" "$source_label" "$generated" || nb_die 1 "could not publish the release; live data untouched or restored by the next run"
release="$PUBLISHED_RELEASE"
nb_log "published release $release (data/current now points at it)"

extra="$(jq -c --argjson f "$fetched" --argjson r "$reused" --argjson b "$bytes_fetched" \
  '{datasets: .new_count, added: (.added | length), removed: (.removed | length),
    changed: (.changed | length), fetched: $f, reused: $r, bytes_fetched: $b}' "$stage/plan.json")"

if [ "$reload" != 1 ]; then
  write_last_load staged "$release" "$extra"
  nb_log "staged only (reload disabled); run bin/nb-reload to load it"
  exit 0
fi

write_last_load staged "$release" "$extra"
rc=0
"$NB_CODE_DIR/bin/nb-reload" || rc=$?
if [ "$rc" -eq 0 ]; then
  write_last_load reloaded "$release" "$extra"
  prune_releases
else
  write_last_load "reload-failed" "$release" "$extra"
fi
exit "$rc"
