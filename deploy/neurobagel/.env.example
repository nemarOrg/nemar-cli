# NEMAR Neurobagel node: host-local settings (epic #1586, Phase 3, #1589).
#
# `bin/nb-install` copies this file to `.env` (mode 600, never tracked) and fills in @NB_HOME@.
# This file holds placeholders only. Real values, including every credential, are provisioned
# on the host. Versions are NOT set here: they live in pins.env, which is tracked.
#
# Format: KEY=VALUE, one per line, no quotes (Docker Compose treats quotes as literal characters).

# ---- Compose project -------------------------------------------------------------------------
# The project name keeps every container, network and volume distinct from every other compose
# project on the host. Do not change it after the first start: the data volumes are named after it.
COMPOSE_PROJECT_NAME=nemar-neurobagel

# `portal` runs the federation API and the query tool for LOCAL verification only (they are
# loopback-only and query nothing but this node). Remove it to free 192 MiB of limits.
# Add `tunnel` only after the lead approves the hostname (README, "Cloudflare Tunnel").
COMPOSE_PROFILES=portal

# ---- Paths (absolute; filled in by nb-install) ----------------------------------------------
NB_HOME=@NB_HOME@
# The recipes init container reads every *.jsonld in this directory. It is a symlink that the
# loader swaps atomically between release directories.
LOCAL_GRAPH_DATA=@NB_HOME@/data/current
# Directory holding NB_GRAPH_ADMIN_PASSWORD.txt and NB_GRAPH_PASSWORD.txt (generated on the
# host by nb-install, mode 700 directory, never copied anywhere else).
NB_GRAPH_SECRETS_PATH=@NB_HOME@/secrets

# ---- Graph store -----------------------------------------------------------------------------
NB_GRAPH_USERNAME=nbgraph
NB_GRAPH_DB=repositories/nemar
# GraphDB Java heap (-Xmx). GraphDB refuses any group-by or distinct query while less than 250 MB
# of heap is free. Measured with the stock image on 50,105 synthetic subjects (879 thousand
# statements): 1 GiB refused the heaviest node queries, 1.5 GiB serves every dataset-level query
# and refuses only the unrestricted subject-level one, 2 GiB refused nothing but needs a 2560m
# container limit and a 512m API, which is over the 3 GiB budget. See README, "Measured footprint".
NB_GRAPH_MEMORY=1536M

# ---- Node API: response granularity ----------------------------------------------------------
# MUST stay true. Epic #1586: participant-level records are never exposed. `nb-status` and
# every reload fail if the node returns anything other than protected records.
NB_RETURN_AGG=true
# Minimum number of matching subjects a dataset needs to appear in a result (the stock value, 0,
# shows every match). 0 is acceptable here because only public datasets are ever federated (epic
# #1586, ADR 0082). If non-public data were ever federated this MUST be raised first.
NB_MIN_CELL_SIZE=0
NB_NAPI_ALLOWED_ORIGINS=*
# The tunnel maps a hostname to the API root, so there is no sub path.
NB_NAPI_BASE_PATH=
NB_FAPI_BASE_PATH=
NB_QUERY_APP_BASE_PATH=/
NB_ENABLE_AUTH=false
NB_QUERY_CLIENT_ID=
NB_QUERY_HEADER_SCRIPT=
NB_CONFIG=Neurobagel
NB_CATALOG_MODE=false

# ---- Loopback ports ----------------------------------------------------------------------------
# Neurobagel's stock defaults (8000, 8080, 3000, 7200) are remapped so they cannot collide with
# other services on the host; check these are free with `ss -ltn` before first start. All are
# published on 127.0.0.1 only, and GraphDB publishes none.
NB_NAPI_PORT_HOST=18000
NB_FAPI_PORT_HOST=18080
NB_QUERY_PORT_HOST=13000
# What a BROWSER uses to reach the f-API when the query tool is opened through an ssh tunnel that
# forwards local 13000 and 18080 to these ports.
NB_API_QUERY_URL=http://localhost:18080

# ---- Hard limits (compose enforces mem_limit == memswap_limit, so no swap) --------------------
# Everything on, at the defaults: graph 2048 + api 512 + f-API 128 + query tool 64 + tunnel
# connector 128 = 2880 MiB, under the epic's 3 GiB (3072 MiB) ceiling. The init container (256 MiB
# limit) runs for seconds during a reload and measured 30 MiB.
NB_GRAPH_MEM_LIMIT=2048m
# GraphDB Free is licensed for one CPU core ("Max CPU cores: 1" in its startup log); the second
# core goes to the JVM's own threads while it loads.
NB_GRAPH_CPUS=2.0
# 384m is not enough: the unrestricted subject-level query over 50k subjects got the API killed.
NB_API_MEM_LIMIT=512m
NB_API_CPUS=1.0
NB_FAPI_MEM_LIMIT=128m
NB_FAPI_CPUS=0.5
NB_QUERY_MEM_LIMIT=64m
NB_QUERY_CPUS=0.5
NB_INIT_MEM_LIMIT=256m
NB_INIT_CPUS=1.0

# ---- Cloudflare Tunnel (profile `tunnel`, off until approved) --------------------------------
# Paste the connector token from the Zero Trust dashboard here, in the host's .env only.
NB_TUNNEL_TOKEN=

# ---- Pull loader ------------------------------------------------------------------------------
# https base URL, or a local directory, that serves index.json and the artifacts it lists. Plain
# http is refused unless NB_ALLOW_HTTP=1 (tests and local development). A URL with credentials in it
# is refused: use the header file below. See README, "Artifact store interface".
NB_SOURCE=
# Optional: path to a file (mode 600) holding ONE complete header line, for example
# `Authorization: Bearer <token>`. It is handed to curl with -H @file, so the token never
# appears in a process listing.
NB_SOURCE_AUTH_HEADER_FILE=
# Seconds the whole reload may take before it is declared failed and rolled back.
NB_RELOAD_TIMEOUT_S=3600
# A reload is refused unless the host has at least this much memory available (MiB).
NB_MIN_AVAILABLE_MB=1800
# Below this the guard stops THIS project (never anything else). The epic's rule is 1.5 GiB.
NB_ABORT_AVAILABLE_MB=1536
# How many release directories to keep for rollback, including the live one.
NB_KEEP_RELEASES=4

# ---- Caps on what the source can make the host do (see README, "Artifact store interface") -----
# The dataset-count cap lives in index.schema.json. These are measured with headroom: the real index
# is a few hundred KB, one dataset's JSON-LD is under 1 MB, a release of 800 datasets is 35 MB.
NB_MAX_INDEX_BYTES=8388608
NB_MAX_ARTIFACT_BYTES=33554432
NB_MAX_TOTAL_BYTES=536870912
# The loader refuses to stage a release with less free disk than this where releases live (MiB).
NB_MIN_FREE_DISK_MB=2048

# ---- Alarms read by `nb status` ----------------------------------------------------------------
# No successful loader run for this long is a problem (only when NB_SOURCE is set). A run that
# finds nothing to do counts as successful.
NB_LOADER_STALE_S=7200
# A guard heartbeat older than this is a problem.
NB_GUARD_STALE_S=1200

# ---- Backups -------------------------------------------------------------------------------------
# Archives are written under backups/ on the SAME disk as the node. Optional off-host copy: a shell
# command run for each archive with its path as $1, for example
#   NB_BACKUP_HOOK=rclone copyto "$1" remote:nb-backups/"$(basename "$1")"
NB_BACKUP_HOOK=
