# Pinned upstream versions for the NEMAR Neurobagel node (epic #1586, Phase 3, #1589).
#
# Tracked in git on purpose: a version change is an upgrade and goes through a pull request.
# Host-specific values and paths live in .env (mode 600, not tracked); versions live here.
# Every image is pinned by tag AND by manifest-list digest, so a moved tag cannot change what runs.
# The `<tag>@sha256:<digest>` form is deliberate: the recipes compose file builds the image name
# as `neurobagel/api:${NB_NAPI_TAG}`, so the digest rides inside the tag variable.
#
# Verified 2026-10-01 against Docker Hub and the GitHub releases API:
#   recipes v0.9.1 (2026-06-04, main has only CI changes since), n-API v0.11.0 (2026-09-14),
#   f-API v0.10.0 (2026-09-14), query tool v0.17.0 (2026-09-15), GraphDB 10.8.12 (the image
#   recipes v0.9.1 pins; 10.8.13 and 10.8.14 exist and are not adopted without a decision).

NB_RECIPES_REPO=https://github.com/neurobagel/recipes.git
NB_RECIPES_TAG=v0.9.1
NB_RECIPES_COMMIT=9f8db034c9586abbd8c91c4c1216928ceedec312

NB_NAPI_TAG=v0.11.0@sha256:9e68de4613a49e9e605179cc65928b3b4e4fe762ab7b5b0c2eb614ca36c71df0
NB_FAPI_TAG=v0.10.0@sha256:1f3a161f3faa9902620541fa4bcf552c8eb4d113c5f1576d064d4d8d1d373584
NB_QUERY_TAG=v0.17.0@sha256:6ceb0212d948d2e5cd1b13986b6d16e2def1c2e0ed87a9f8dbb784276e0bd8da
NB_GRAPHDB_IMAGE=ontotext/graphdb:10.8.12@sha256:ee7d600abf25517cd06e075fa882e86909dacd1d9842d7d15df5048ee89d472c

# Optional tunnel connector (profile `tunnel`, off by default; same image family the other
# nemaring projects run as their cloudflared container).
NB_CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.9.3@sha256:072c067d25ccbe61d46e18f0d0723255f2bb5304f7317caa95b27031520ff92c
