        "power_line_frequency": {
          "type": [
            "number",
            "null"
          ],
          "description": "Power line frequency in Hz (typically 50 or 60).",
          "enum": [
            50,
            60,
            null
          ]
        },
        "reference": {
          "type": [
            "string",
            "null"
          ],
          "description": "EEG reference (e.g., 'nose', 'Cz', 'average')."
        },
        "recording_type": {
