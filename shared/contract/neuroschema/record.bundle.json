            "string",
            "null"
          ],
          "description": "Recording type (e.g., 'continuous', 'epoched')."
        },
        "channel_system": {
          "type": [
            "string",
            "null"
          ],
          "description": "Electrode placement system (e.g., '10-20', '10-10', '10-5', 'GSN-HydroCel-129', 'other')."
        },
        "placement_scheme": {
          "type": [
            "string",
            "null"
          ],
          "description": "Detailed electrode placement scheme from BIDS EEG sidecar (e.g., 'extended 10-10% system')."
