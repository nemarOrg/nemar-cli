{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nemarOrg/nemar-cli/shared/contract/compute-observation.schema.json",
  "title": "nemar.observation.v1",
  "description": "The document the queue observer posts to NEMAR: one JSON object per run, in 'quick' mode (every 15 minutes: the queue per partition and the pending starts) or 'daily' mode (the same plus the previous day's sacct export in 'accounting'). It is what observer/observe.py in nemarOrg/nemar-process emits, written once and shared byte for byte between nemarOrg/nemar-cli (shared/contract/compute-observation.schema.json) and nemarOrg/nemar-process (observer/schema/observation-v1.schema.json): whichever side needs a change writes it in nemar-cli, the other copies it. The observer never invents: a command that failed or was not read is reported in 'sources' and what it would have said is null, never zero. Every object the observer writes is closed (no unknown keys). The post is JSON text, at most 1 MiB, with 'Authorization: Bearer <token>'; the token is not part of the document. Rules this schema cannot state, which the Worker checks: the 5,000-row bound on partitions and accounting jobs together, and that a post is one run's. In 'accounting.jobs', alloc_tres holds Slurm's AllocTRES items as the observer split them (key to value text, for example cpu '4', mem '8G', node '1', gres/gpu '1'); the Worker reads cpu, mem, node and gres/gpu from it and refuses a value it cannot read.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mode",
    "observed_at",
    "observer_version",
    "sources",
    "partitions",
    "pending_starts",
    "balance"
  ],
  "properties": {
    "schema": {
      "const": "nemar.observation.v1"
    },
    "mode": {
      "enum": ["quick", "daily"]
    },
    "observed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])"
    },
    "observer_version": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[0-9A-Za-z][0-9A-Za-z.+-]*(?![\\s\\S])"
    },
    "sources": {
      "description": "What each command said. sacct is present in daily mode only.",
      "type": "object",
      "additionalProperties": false,
      "required": ["sinfo", "squeue", "squeue_start"],
      "properties": {
        "sinfo": { "$ref": "#/$defs/source" },
        "squeue": { "$ref": "#/$defs/source" },
        "squeue_start": { "$ref": "#/$defs/source" },
        "sacct": { "$ref": "#/$defs/source" }
      }
    },
    "partitions": {
      "description": "One entry per partition seen by sinfo or squeue.",
      "type": "object",
      "maxProperties": 5000,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_.,-]{1,128}(?![\\s\\S])"
      },
      "additionalProperties": { "$ref": "#/$defs/partition" }
    },
    "pending_starts": {
      "description": "squeue --start for the jobs NEMAR named: null when the command was not read, an empty list when none was named.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "array",
          "maxItems": 5000,
          "items": { "$ref": "#/$defs/pending_start" }
        }
      ]
    },
    "balance": {
      "description": "The allocation balance read with expanse-client, for the two resources. NEMAR does not read it into the ledger.",
      "type": "object",
      "additionalProperties": false,
      "required": ["expanse", "expanse_gpu"],
      "properties": {
        "expanse": { "$ref": "#/$defs/balance" },
        "expanse_gpu": { "$ref": "#/$defs/balance" }
      }
    },
    "job_ids_dropped": {
      "description": "Present only when job ids NEMAR named were invalid or past the 500 the observer passes.",
      "type": "integer",
      "minimum": 1
    },
    "accounting": {
      "description": "The sacct export for one day. Present in daily mode only; null when sacct was not read (see sources.sacct).",
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/accounting" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "mode": { "const": "quick" } },
        "required": ["mode"]
      },
      "then": {
        "not": { "required": ["accounting"] },
        "properties": {
          "sources": { "not": { "type": "object", "required": ["sacct"] } }
        }
      },
      "else": {
        "required": ["accounting"],
        "properties": {
          "sources": { "type": "object", "required": ["sacct"] }
        }
      }
    }
  ],
  "$defs": {
    "count": {
      "description": "A natural number the observer read from at most twelve digits.",
      "type": "integer",
      "minimum": 0,
      "maximum": 999999999999
    },
    "time": {
      "description": "A Slurm time in the form YYYY-MM-DDTHH:MM:SS (no zone: the cluster's), or null when Slurm printed Unknown, N/A or another form.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?![\\s\\S])"
        }
      ]
    },
    "source": {
      "description": "A command that was read ('ok', or 'unparsed' when every row was in a format the observer does not know) with the rows it could not read, or a fixed word for why it was not read.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "malformed_rows"],
          "properties": {
            "status": { "enum": ["ok", "unparsed"] },
            "malformed_rows": { "$ref": "#/$defs/count" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "enum": ["not_found", "timeout", "failed", "error", "skipped"] },
            "detail": {
              "type": "string",
              "pattern": "^[a-z0-9_]{1,64}(?![\\s\\S])"
            }
          }
        }
      ]
    },
    "partition": {
      "description": "One partition. A source that was not read gives null, never zero.",
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "nodes", "jobs", "pending_reasons"],
      "properties": {
        "available": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 32 }
          ]
        },
        "nodes": {
          "description": "Node count by node state (lower case, flags removed).",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "propertyNames": { "pattern": "^[a-z_]{1,32}(?![\\s\\S])" },
              "additionalProperties": { "$ref": "#/$defs/count" }
            }
          ]
        },
        "jobs": {
          "description": "Jobs, nodes and CPUs by job state (for example PENDING, RUNNING).",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "propertyNames": { "pattern": "^[A-Z_]{1,32}(?![\\s\\S])" },
              "additionalProperties": { "$ref": "#/$defs/job_totals" }
            }
          ]
        },
        "pending_reasons": {
          "description": "Pending jobs by the first word of Slurm's reason.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "propertyNames": { "pattern": "^[A-Za-z0-9_]{1,64}(?![\\s\\S])" },
              "additionalProperties": { "$ref": "#/$defs/count" }
            }
          ]
        }
      }
    },
    "job_totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jobs", "nodes", "cpus"],
      "properties": {
        "jobs": { "$ref": "#/$defs/count" },
        "nodes": { "$ref": "#/$defs/count" },
        "cpus": { "$ref": "#/$defs/count" }
      }
    },
    "pending_start": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "partition", "state", "expected_start"],
      "properties": {
        "job_id": { "type": "string", "pattern": "^[0-9]{1,12}(?![\\s\\S])" },
        "partition": { "type": "string", "pattern": "^[A-Za-z0-9_.,-]{1,128}(?![\\s\\S])" },
        "state": { "type": "string", "maxLength": 32 },
        "expected_start": { "$ref": "#/$defs/time" }
      }
    },
    "balance": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "projects"],
          "properties": {
            "status": { "const": "parsed" },
            "projects": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["project", "used", "available", "used_by_project"],
                "properties": {
                  "project": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}(?![\\s\\S])" },
                  "used": { "$ref": "#/$defs/count" },
                  "available": { "$ref": "#/$defs/count" },
                  "used_by_project": { "$ref": "#/$defs/count" }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "raw_lines"],
          "properties": {
            "status": { "const": "unparsed" },
            "raw_lines": {
              "type": "array",
              "maxItems": 50,
              "items": { "type": "string", "maxLength": 200 }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "detail"],
          "properties": {
            "status": { "const": "unavailable" },
            "detail": { "type": "string", "pattern": "^[a-z0-9_]{1,64}(?![\\s\\S])" }
          }
        }
      ]
    },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["day", "rows_total", "rows_included", "truncated", "jobs"],
      "properties": {
        "day": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?![\\s\\S])" },
        "rows_total": { "$ref": "#/$defs/count" },
        "rows_included": { "$ref": "#/$defs/count" },
        "truncated": {
          "description": "True when the rows past the 1 MiB body were cut from the end; rows_included then counts those that remain.",
          "type": "boolean"
        },
        "jobs": {
          "type": "array",
          "maxItems": 5000,
          "items": { "$ref": "#/$defs/accounting_job" }
        }
      }
    },
    "accounting_job": {
      "description": "One sacct row (sacct -X -P -n), without a user name. A field the observer could not read is null.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "partition",
        "state",
        "elapsed_seconds",
        "alloc_tres",
        "submit",
        "start",
        "end"
      ],
      "properties": {
        "job_id": {
          "description": "Slurm's JobID as printed: digits, and for an array task or a heterogeneous component also _ + [ ] , % -.",
          "type": "string",
          "pattern": "^[0-9][0-9_+\\[\\],%-]{0,63}(?![\\s\\S])"
        },
        "partition": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[A-Za-z0-9_.,-]{1,128}(?![\\s\\S])" }
          ]
        },
        "state": {
          "description": "The first word of Slurm's state ('CANCELLED by 1234' is 'CANCELLED').",
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[A-Za-z_]{1,32}(?![\\s\\S])" }
          ]
        },
        "elapsed_seconds": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 0 }
          ]
        },
        "alloc_tres": {
          "description": "Slurm's AllocTRES, split at commas and equals signs: item name to value text, at most 32 items, empty for a job that was never allocated anything.",
          "type": "object",
          "maxProperties": 32,
          "propertyNames": { "maxLength": 64 },
          "additionalProperties": { "type": "string", "maxLength": 64 }
        },
        "submit": { "$ref": "#/$defs/time" },
        "start": { "$ref": "#/$defs/time" },
        "end": { "$ref": "#/$defs/time" }
      }
    }
  }
}
