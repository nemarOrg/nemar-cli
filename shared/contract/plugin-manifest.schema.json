{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.nemar.org/schemas/plugin-manifest-v1.json",
  "title": "NEMAR quality plugin manifest, nemar.plugin-manifest.v1",
  "description": "What a NEMAR quality plugin declares before it runs (ADR 0134 decision 6): its name, version, the Python module to load, the checkpoint it belongs to, what it reads, its fixed parameters, and the metrics and figures it writes. Copied byte for byte from nemarOrg/nemar-cli (shared/contract/plugin-manifest.schema.json) by nemarOrg/nemar-process. Closed. A declared metric, with a run's value (a number or null) and the plugin's name and version, is a valid neuroschema qualityMetric; its bounds are the valid range the plugin declares. A figure is png, svg or webp, at most 1048576 bytes; a time-series figure is png or webp only. Rules a schema cannot state are the reader's: a metric's bounds have min <= max when both are set; a quality plugin declares at least one metric and a figures plugin at least one figure. A manifest is at most 65536 bytes.",
  "$defs": {
    "Range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": ["number", "null"] },
        "max": { "type": ["number", "null"] }
      }
    },
    "Metric": {
      "description": "One metric a plugin writes: neuroschema qualityMetric without the run's value and the plugin.",
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "description"],
      "properties": {
        "unit": { "type": "string", "minLength": 1, "maxLength": 32 },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "bounds": { "$ref": "#/$defs/Range" },
        "headline": { "type": "boolean" }
      }
    },
    "Figure": {
      "description": "One display figure a plugin writes.",
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "time_series", "caption", "max_bytes"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["png", "svg", "webp"] }
        },
        "time_series": { "type": "boolean" },
        "caption": { "type": "string", "minLength": 1, "maxLength": 500 },
        "max_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 }
      },
      "if": {
        "type": "object",
        "properties": { "time_series": { "const": true } },
        "required": ["time_series"]
      },
      "then": {
        "type": "object",
        "properties": {
          "formats": { "type": "array", "items": { "enum": ["png", "webp"] } }
        }
      }
    },
    "ParameterValue": {
      "anyOf": [
        { "type": "number" },
        { "type": "string", "maxLength": 256 },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "array", "maxItems": 64, "items": { "type": "number" } }
      ]
    },
    "PluginManifest": {
      "description": "The manifest. Closed.",
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "name", "version", "entry", "checkpoint", "reads", "parameters", "outputs"],
      "properties": {
        "format": { "const": "nemar.plugin-manifest.v1" },
        "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}(?![\\s\\S])" },
        "version": { "type": "string", "pattern": "^[0-9A-Za-z._+-]{1,64}(?![\\s\\S])" },
        "entry": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*(?![\\s\\S])"
        },
        "checkpoint": { "enum": ["quality", "figures"] },
        "reads": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dataset", "recipes"],
          "properties": {
            "dataset": { "type": "boolean" },
            "recipes": {
              "type": "array",
              "maxItems": 8,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z0-9-]{1,64}(?![\\s\\S])" }
            }
          },
          "anyOf": [
            { "type": "object", "properties": { "dataset": { "const": true } } },
            { "type": "object", "properties": { "recipes": { "type": "array", "minItems": 1 } } }
          ]
        },
        "parameters": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}(?![\\s\\S])" },
          "additionalProperties": { "$ref": "#/$defs/ParameterValue" }
        },
        "outputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["metrics", "figures"],
          "properties": {
            "metrics": {
              "type": "object",
              "maxProperties": 64,
              "propertyNames": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_:-]{0,127}(?![\\s\\S])" },
              "additionalProperties": { "$ref": "#/$defs/Metric" }
            },
            "figures": {
              "type": "object",
              "maxProperties": 32,
              "propertyNames": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}(?![\\s\\S])" },
              "additionalProperties": { "$ref": "#/$defs/Figure" }
            }
          }
        }
      }
    }
  }
}
